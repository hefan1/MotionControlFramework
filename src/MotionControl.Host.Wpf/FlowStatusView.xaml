<UserControl x:Class="MotionControl.Host.Wpf.FlowStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,8,14,12">
            <Border Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1"
                    CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="MachineStateText" FontSize="12" FontWeight="SemiBold" Foreground="#26384D" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D9E0E8" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 工位当前步骤}" FontSize="13" FontWeight="SemiBold" Foreground="#26384D" />
                    <StackPanel x:Name="StationRowsPanel" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 当前报警}" FontSize="13" FontWeight="SemiBold" Foreground="#26384D" />
                    <TextBlock x:Name="AlarmText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#40536A" />
                    <TextBlock x:Name="LastErrorText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#B45309" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
