<UserControl x:Class="MotionControl.Host.Wpf.FlowStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MotionControl.TaskEngine.Wpf;component/Styles/TaskMonitorStyles.xaml" />
                <ResourceDictionary Source="/MotionControl.Framework.Wpf;component/Styles/ScrollBarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,8,14,12">
            <Border Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1"
                    CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="MachineStateText" FontSize="12" FontWeight="SemiBold" Foreground="#26384D" />
                    <TextBlock x:Name="ResetGuidanceText" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#845B0A" Visibility="Collapsed" />
                    <TextBlock x:Name="StartReadinessText" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#845B0A" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D9E0E8" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel x:Name="StationRowsPanel" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource 流程页.CSharp来源}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,8" />
                        <Grid x:Name="CSharpStationWorkspace" SizeChanged="CSharpStationWorkspace_SizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CSharpStationColumn" Width="1.1*"/><ColumnDefinition x:Name="CSharpFirstGapColumn" Width="10"/><ColumnDefinition x:Name="CSharpStepsColumn" Width="2.4*"/><ColumnDefinition x:Name="CSharpSecondGapColumn" Width="10"/><ColumnDefinition x:Name="CSharpDetailsColumn" Width="1.8*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition x:Name="CSharpStationRow" Height="Auto"/><RowDefinition x:Name="CSharpFirstGapRow" Height="0"/><RowDefinition x:Name="CSharpStepsRow" Height="0"/><RowDefinition x:Name="CSharpSecondGapRow" Height="0"/><RowDefinition x:Name="CSharpDetailsRow" Height="0"/></Grid.RowDefinitions>
                            <Border x:Name="CSharpStationListCard" Background="#F7F9FC" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource 流程页.工位列表}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <Grid>
                                        <ListBox x:Name="StationList" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        <ComboBox x:Name="NarrowCSharpStationPicker" DisplayMemberPath="StationName" SelectionChanged="NarrowCSharpStationPicker_SelectionChanged" Visibility="Collapsed" MinHeight="34"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CSharpStepsCard" Grid.Column="2" Background="#F7F9FC" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="StationStepHeadingText" FontSize="14" FontWeight="SemiBold" Foreground="#26384D" />
                                    <TextBlock x:Name="CSharpCurrentStepText" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,8"/>
                                    <TextBlock Text="{DynamicResource 流程页.CSharp步骤范围说明}" TextWrapping="Wrap" Foreground="#596B7D"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CSharpStationDetailsCard" Grid.Column="4" Background="#F7F9FC" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource 流程页.选中工位}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="StationDetailText" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,8" />
                                    <Button x:Name="StationInputButton" Content="{DynamicResource 流程页.核对输入}" Click="OpenStationInput_Click" HorizontalAlignment="Left" Padding="10,4" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="NoAutomaticRunText" Text="{DynamicResource 流程页.当前未启用自动运行}" TextWrapping="Wrap" Foreground="#40536A" Visibility="Collapsed" />
                    <StackPanel x:Name="TaskRunPanel" Visibility="Collapsed">
                        <TextBlock x:Name="TaskRunStatusText" TextWrapping="Wrap" Foreground="#40536A" FontSize="13" />
                        <Button Content="{DynamicResource 流程页.查看任务运行}" Click="OpenTaskRun_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0" />
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="{DynamicResource 流程页.查看轴监控}" Click="OpenAxisMonitor_Click" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource 流程页.打开IO监控}" ToolTip="{DynamicResource 流程页.IO监控说明}"
                                Click="OpenIoMonitor_Click" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource 流程页.查看当前报警}" Click="OpenCurrentAlarms_Click" Padding="10,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StationAlarmSummaryText" TextWrapping="Wrap" Foreground="#B45309" Margin="0,0,0,8" Visibility="Collapsed" />
            <Border x:Name="AlarmDetailsPanel" Background="White" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 当前报警}" FontSize="13" FontWeight="SemiBold" Foreground="#26384D" />
                    <TextBlock x:Name="AlarmText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#40536A" />

                </StackPanel>
            </Border>
            <TextBlock x:Name="LastErrorText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#B45309" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
