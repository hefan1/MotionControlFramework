<Window x:Class="MotionControl.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource 运动控制上位机}"
        Height="900"
        Width="1440"
        MinHeight="700"
        MinWidth="1024"
        Background="#F1F3F5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PrimaryNavigationButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="Foreground" Value="#25282B" />
            <Setter Property="Background" Value="#ECEEF0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowDuration" Value="6000" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#A9D997" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.82" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarNavigationButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="43" />
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#25282B" />
            <Setter Property="Background" Value="#F4F5F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#A9D997" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.82" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MachineCommandButton" TargetType="Button">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#202326" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D5D9DC"
                BorderThickness="1,1,1,0">
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="PrimaryNavigation"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ToggleButton Tag="Home" Content="⌂" ToolTip="{DynamicResource 首页}" IsChecked="True" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                    <ToggleButton Tag="Statistics" Content="▥" ToolTip="{DynamicResource 统计}" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                    <ToggleButton Tag="Monitor" Content="◉" ToolTip="{DynamicResource 监控}" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                    <ToggleButton Tag="Manual" Content="☞" ToolTip="{DynamicResource 手动}" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                    <ToggleButton Tag="Settings" Content="⚙" ToolTip="{DynamicResource 设置}" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                    <ToggleButton Tag="Alarms" Content="♢" ToolTip="{DynamicResource 报警}" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                    <ToggleButton Tag="Users" Content="♟" ToolTip="{DynamicResource 用户管理}" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                    <ToggleButton Tag="Help" Content="?" ToolTip="{DynamicResource 帮助}" Style="{StaticResource PrimaryNavigationButton}" Click="PrimaryNavigationButton_Click" />
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="8,4"
                        Background="#EEF0F2"
                        CornerRadius="6">
                    <TextBlock x:Name="HeaderMessage"
                               Text="{DynamicResource 单机运行控制卡未连接}"
                               FontSize="15"
                               Foreground="#44494D"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Tag="外壳预览启动命令未接入设备控制逻辑" Content="{DynamicResource 启动}"
                            Background="#B8E6A5"
                            Style="{StaticResource MachineCommandButton}"
                            Click="MachineCommandButton_Click"
                            ToolTip="{DynamicResource 外壳预览启动命令提示}" />
                    <Button Tag="外壳预览暂停命令未接入设备控制逻辑" Content="{DynamicResource 暂停}"
                            Background="#8BC4F2"
                            Style="{StaticResource MachineCommandButton}"
                            Click="MachineCommandButton_Click"
                            ToolTip="{DynamicResource 外壳预览暂停命令提示}" />
                    <Button Tag="外壳预览停止命令未接入设备控制逻辑" Content="{DynamicResource 停止}"
                            Background="#E99691"
                            Style="{StaticResource MachineCommandButton}"
                            Click="MachineCommandButton_Click"
                            ToolTip="{DynamicResource 外壳预览停止命令提示}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,8,0,8"
                    Background="White"
                    BorderBrush="#D5D9DC"
                    BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Padding="12,14"
                            BorderBrush="#D5D9DC"
                            BorderThickness="0,0,0,1">
                        <TextBlock x:Name="SidebarTitle"
                            Text="{DynamicResource 首页}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#303438" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarNavigation" Margin="0,5" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,8,0,8"
                    Background="White"
                    BorderBrush="#D5D9DC"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="20,10"
                            Background="#FAFAFA"
                            BorderBrush="#E1E4E6"
                            BorderThickness="0,0,0,1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle"
                                       Text="{DynamicResource 设备总览}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#25282B" />
                            <TextBlock x:Name="PageDescription"
                                       Text="{DynamicResource 该页面为导航占位具体功能后续接入}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#70777C" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Background="White">
                        <StackPanel x:Name="PagePlaceholder" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⌂"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="54"
                                       Foreground="#C3C9CD"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource 工作区占位}"
                                       Margin="0,8,0,0"
                                       FontSize="18"
                                       Foreground="#566068"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource 具体页面与内容后续逐项开发并接入此区域}"
                                       Margin="0,8,0,0"
                                       FontSize="14"
                                       Foreground="#858D92"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <ContentControl x:Name="ManualDebugContent" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D5D9DC"
                BorderThickness="1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 当前用户}" Foreground="#555C61" />
                    <TextBlock Text="{DynamicResource 未登录}" Foreground="#25282B" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Margin="2,0" Padding="8,3" Background="#ECEFF1" CornerRadius="2">
                        <TextBlock x:Name="MotionCardConnectionStatus" Text="{DynamicResource 控制卡未连接}" FontSize="12" Foreground="#5E666B" />
                    </Border>
                    <Border Margin="2,0" Padding="8,3" Background="#ECEFF1" CornerRadius="2">
                        <TextBlock Text="{DynamicResource 通讯未连接}" FontSize="12" Foreground="#5E666B" />
                    </Border>
                    <Border Margin="2,0" Padding="8,3" Background="#ECEFF1" CornerRadius="2">
                        <TextBlock Text="{DynamicResource 数据库未接入}" FontSize="12" Foreground="#5E666B" />
                    </Border>
                    <Border Margin="2,0" Padding="8,3" Background="#ECEFF1" CornerRadius="2">
                        <TextBlock Text="{DynamicResource MES未配置}" FontSize="12" Foreground="#5E666B" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="10,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 设备状态标题}" Foreground="#555C61" />
                    <TextBlock x:Name="CurrentMachineState" Text="{DynamicResource 待机占位}" Foreground="#25282B" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Margin="10,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 语言}" Foreground="#555C61" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageSelector"
                              Width="88"
                              Height="26"
                              SelectedIndex="0"
                              SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem Tag="zh-CN" Content="{DynamicResource 简体中文}" />
                        <ComboBoxItem Tag="en-US" Content="{DynamicResource English}" />
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="ClockText"
                           Grid.Column="4"
                           Margin="10,0,2,0"
                           VerticalAlignment="Center"
                           Foreground="#454B50"
                           Text="----/--/-- --:--:--" />
            </Grid>
        </Border>
    </Grid>
</Window>
