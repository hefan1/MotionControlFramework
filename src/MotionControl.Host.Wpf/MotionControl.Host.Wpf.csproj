<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>MotionControl.Host.Wpf</AssemblyName>
    <RootNamespace>MotionControl.Host.Wpf</RootNamespace>
    <PlatformTarget Condition="'$(PlatformTarget)' == '' or '$(PlatformTarget)' == 'AnyCPU'">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MotionControl.TaskEngine.Wpf\MotionControl.TaskEngine.Wpf.csproj" />
    <ProjectReference Include="..\MotionControl.Equipment.Demo\MotionControl.Equipment.Demo.csproj" />
    <ProjectReference Include="..\MotionControl.Framework.Contracts\MotionControl.Framework.Contracts.csproj" />
    <ProjectReference Include="..\MotionControl.Framework.Runtime\MotionControl.Framework.Runtime.csproj" />
    <ProjectReference Include="..\MotionControl.Framework.Wpf\MotionControl.Framework.Wpf.csproj" />
    <ProjectReference Include="..\MotionControl.TaskEngine.MachineDevice\MotionControl.TaskEngine.MachineDevice.csproj" />
    <ProjectReference Include="..\Adapters\MotionCards\ZMotion\Adapter\MotionControl.Adapter.MotionCard.ZMotion.csproj" />
    <ProjectReference Include="..\Adapters\MotionCards\Virtual\Adapter\MotionControl.Adapter.MotionCard.Virtual.csproj" />
    <ProjectReference Include="..\..\tools\MotionControl.VirtualController\MotionControl.VirtualController.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyDefaultSimulationController" AfterTargets="Build">
    <ItemGroup>
      <_DefaultSimulationFiles Include="$(MSBuildProjectDirectory)\..\..\tools\MotionControl.VirtualController\bin\$(Configuration)\$(TargetFramework)\MotionControl.VirtualController.exe" />
      <_DefaultSimulationFiles Include="$(MSBuildProjectDirectory)\..\..\tools\MotionControl.VirtualController\bin\$(Configuration)\$(TargetFramework)\MotionControl.VirtualController.exe.config" />
    </ItemGroup>
    <Copy SourceFiles="@(_DefaultSimulationFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
