<UserControl x:Class="MotionControl.Host.Wpf.Configuration.AlarmCatalogConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="AlarmCatalogButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="#244A73" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F8FC" />
                    <Setter Property="BorderBrush" Value="#AFC1D6" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E6EEF7" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2475D0" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9AA6B2" />
                    <Setter Property="Background" Value="#EEF1F5" />
                    <Setter Property="BorderBrush" Value="#D5DCE4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmCatalogPrimaryButton" TargetType="Button" BasedOn="{StaticResource AlarmCatalogButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2375D1" />
            <Setter Property="BorderBrush" Value="#2375D1" />
        </Style>
        <Style x:Key="AlarmCatalogHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF2F8" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D9E0E8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.2*" MinHeight="230" />
            <RowDefinition Height="1.2*" MinHeight="210" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="8" Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6">
            <WrapPanel>
                <Button Content="{DynamicResource 报警库新增停机}" Click="AddStopAlarm_Click" Style="{StaticResource AlarmCatalogButton}" />
                <Button Content="{DynamicResource 报警库新增非停机}" Click="AddNonStopAlarm_Click" Style="{StaticResource AlarmCatalogButton}" />
                <Button x:Name="DeleteButton" Content="{DynamicResource 报警库删除}" Click="DeleteAlarm_Click" Style="{StaticResource AlarmCatalogButton}" IsEnabled="False" />
                <Button Content="{DynamicResource 报警库保存}" Click="SaveAlarms_Click" Style="{StaticResource AlarmCatalogPrimaryButton}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,8" Padding="9,7" Background="#EFF6FF"
                BorderBrush="#C8DCF5" BorderThickness="1" CornerRadius="5">
            <TextBlock x:Name="SummaryText" Text="{DynamicResource 报警库运行语义}" Foreground="#40536A" TextWrapping="Wrap" />
        </Border>

        <DataGrid x:Name="AlarmGrid" Grid.Row="2" ItemsSource="{Binding Alarms}"
                  SelectionChanged="AlarmGrid_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0" ColumnHeaderStyle="{StaticResource AlarmCatalogHeader}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource 报警库代码}" Binding="{Binding Code}" Width="210" />
                <DataGridTextColumn Header="{DynamicResource 报警库说明}" Binding="{Binding Message}" Width="2*" MinWidth="220" />
                <DataGridTextColumn Header="{DynamicResource 报警库类型}" Binding="{Binding KindDisplay}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,8,0,8" Padding="12" Background="White"
                BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource 报警库代码}" VerticalAlignment="Center" Foreground="#40536A" Margin="0,4" />
                    <TextBox x:Name="CodeBox" Grid.Column="1" TextChanged="AlarmField_TextChanged" MinHeight="30" Padding="7,4" />
                    <TextBlock Grid.Row="1" Text="{DynamicResource 报警库说明}" VerticalAlignment="Center" Foreground="#40536A" Margin="0,4" />
                    <TextBox x:Name="MessageTextBox" Grid.Row="1" Grid.Column="1" TextChanged="AlarmField_TextChanged" MinHeight="30" Padding="7,4" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource 报警库类型}" VerticalAlignment="Center" Foreground="#40536A" Margin="0,4" />
                    <ComboBox x:Name="KindBox" Grid.Row="2" Grid.Column="1" SelectedValuePath="Tag"
                              SelectionChanged="KindBox_SelectionChanged" MinHeight="30" Padding="5">
                        <ComboBoxItem Tag="StopMachine" Content="{DynamicResource 停机报警}" />
                        <ComboBoxItem Tag="NonStop" Content="{DynamicResource 非停机报警}" />
                    </ComboBox>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{DynamicResource 报警库代码提示}" Margin="0,6,0,0"
                               Foreground="#596B7D" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource 报警库先检查}" Foreground="#40536A" Margin="0,0,0,4" />
                    <TextBox x:Name="CheckGuidanceBox" Grid.Row="1" TextChanged="AlarmField_TextChanged"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="52" Padding="7,5" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource 报警库恢复步骤}" Foreground="#40536A" Margin="0,7,0,4" />
                    <TextBox x:Name="RecoveryGuidanceBox" Grid.Row="3" TextChanged="AlarmField_TextChanged"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="52" Padding="7,5" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="#176BD0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
