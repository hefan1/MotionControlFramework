<UserControl x:Class="MotionControl.Host.Wpf.Operation.CurrentAlarmsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/MotionControl.TaskEngine.Wpf;component/Styles/TaskMonitorStyles.xaml"/><ResourceDictionary Source="/MotionControl.Framework.Wpf;component/Styles/ScrollBarStyles.xaml"/>
  <ResourceDictionary Source="Localization/Strings.Operation.zh-CN.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <Style x:Key="指导块" TargetType="Border" BasedOn="{StaticResource 内容边框}"><Setter Property="Padding" Value="13"/><Setter Property="Margin" Value="5"/><Setter Property="MinHeight" Value="92"/></Style>
 <Style x:Key="指导标题" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style x:Key="报警等级" TargetType="TextBlock"><Setter Property="Foreground" Value="#946200"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/><Style.Triggers><DataTrigger Binding="{Binding Alarm.RequiresReset}" Value="True"><Setter Property="Foreground" Value="#BE3737"/></DataTrigger></Style.Triggers></Style>
 </ResourceDictionary></UserControl.Resources>
 <TabControl x:Name="AlarmTabs" Margin="14,8,14,12">
 <TabItem x:Name="CurrentAlarmsTab" Header="{DynamicResource 操作页.当前报警标签}">
 <Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.1*" MinHeight="100"/><RowDefinition x:Name="DetailsRow" Height="1.6*" MinHeight="160"/></Grid.RowDefinitions>
  <Border Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="7"><DockPanel>
   <Button DockPanel.Dock="Right" Content="{DynamicResource 操作页.刷新}" Click="Refresh_Click"/>
   <WrapPanel><Border Background="#2375D1" CornerRadius="4" Padding="12,7" Margin="3"><TextBlock x:Name="CountText" Foreground="White" FontWeight="SemiBold"/></Border>
    <TextBlock Text="{DynamicResource 操作页.搜索}" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="SearchBox" Width="260" MinHeight="30" Margin="8,3" Padding="7,4" VerticalContentAlignment="Center" TextChanged="SearchChanged" ToolTip="{DynamicResource 操作页.搜索工位代码或报警内容}"/>
    <TextBlock x:Name="FilterCountText" VerticalAlignment="Center" Margin="8,3"/><Button x:Name="ClearFilterButton" Content="{DynamicResource 操作页.清除报警筛选}" Click="ClearFilter_Click" Margin="8,3"/>
   </WrapPanel>
  </DockPanel></Border>
  <ScrollViewer Grid.Row="1" MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SourceText" Margin="2,7" Foreground="#596B7D" TextWrapping="Wrap"/></ScrollViewer>
  <Grid Grid.Row="2"><DataGrid x:Name="AlarmGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="AlarmSelected"><DataGrid.Columns>
   <DataGridTextColumn Binding="{Binding KindText}" Width="75" ElementStyle="{StaticResource 报警等级}"/><DataGridTextColumn Binding="{Binding OccurredAt}" Width="165"/>
   <DataGridTextColumn Binding="{Binding Alarm.SourceName}" Width="1*" MinWidth="110"/><DataGridTextColumn Binding="{Binding Alarm.Definition.Message}" Width="1.8*" MinWidth="180"/><DataGridTextColumn Binding="{Binding ConditionText}" Width="140"/>
  </DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#596B7D" IsHitTestVisible="False"/></Grid>
  <Border x:Name="DetailsPanel" Grid.Row="3" Style="{StaticResource 内容边框}" Margin="0,10,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6">
   <UniformGrid Columns="2">
    <Border Style="{StaticResource 指导块}"><StackPanel><TextBlock Text="{DynamicResource 操作页.1 发生在哪里}" Style="{StaticResource 指导标题}"/><TextBlock x:Name="WhereText" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Style="{StaticResource 指导块}"><StackPanel><TextBlock x:Name="CauseTitle" Text="{DynamicResource 操作页.2 当前为什么不能运行}" Style="{StaticResource 指导标题}"/><TextBlock x:Name="CauseText" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Style="{StaticResource 指导块}"><StackPanel><TextBlock Text="{DynamicResource 操作页.3 先检查什么}" Style="{StaticResource 指导标题}"/><TextBlock x:Name="CheckText" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Style="{StaticResource 指导块}"><StackPanel><TextBlock Text="{DynamicResource 操作页.4 处理后做什么}" Style="{StaticResource 指导标题}"/><TextBlock x:Name="AfterText" TextWrapping="Wrap"/></StackPanel></Border>
   </UniformGrid>
   <WrapPanel Margin="5,3"><Button x:Name="FlowButton" Content="{DynamicResource 操作页.定位工位流程}" Click="Flow_Click"/>
    <Button x:Name="IoButton" Content="{DynamicResource 操作页.查看IO监控}" Click="Io_Click"/><Button x:Name="AxisButton" Content="{DynamicResource 操作页.进入轴手动}" Click="Axis_Click"/>
   </WrapPanel>
   <TextBlock Margin="10,3" Foreground="#596B7D" TextWrapping="Wrap" Text="{DynamicResource 操作页.跳转不会动作，未配置关联轴IO时仅打开页面}"/>
   <Expander Margin="9" Header="{DynamicResource 操作页.工程诊断}"><TextBox x:Name="DiagnosticText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" BorderBrush="#D9E0E8" Padding="8"/></Expander>
  </StackPanel></ScrollViewer></Border>
 </Grid>
 </TabItem>
 <TabItem x:Name="DiagnosticEventsTab" Header="{DynamicResource 操作页.诊断与事件标签}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
   <Border Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel>
    <TextBlock x:Name="DiagnosticEventsUnavailable" Text="{DynamicResource 操作页.事件服务未接入}" FontSize="15" FontWeight="SemiBold" Foreground="#40536A" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource 操作页.事件服务边界}" Margin="0,10,0,0" Foreground="#596B7D" TextWrapping="Wrap"/>
    <Button x:Name="ExportDiagnosticPackageButton" Content="{DynamicResource 操作页.导出支持包未接入}" ToolTip="{DynamicResource 操作页.事件服务未接入}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></Border>
   <TextBlock Text="{DynamicResource 操作页.事件保留原诊断}" Margin="0,12,0,0" Foreground="#596B7D" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
 </TabItem>
 </TabControl>
</UserControl>
