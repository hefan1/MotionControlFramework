<UserControl x:Class="MotionControl.Host.Wpf.Operation.AlarmHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/MotionControl.TaskEngine.Wpf;component/Styles/TaskMonitorStyles.xaml"/>
  <ResourceDictionary Source="/MotionControl.Framework.Wpf;component/Styles/ScrollBarStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="14,8,14,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="10">
   <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click" Padding="16,6"/><TextBlock Text="最近 7 天，最多显示 1000 条" Foreground="#40536A" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <TextBlock x:Name="StatusText" Grid.Row="1" Margin="2,10" Foreground="#596B7D" TextWrapping="Wrap"/>
  <Grid Grid.Row="2"><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="HistorySelectionChanged">
   <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="变化" Binding="{Binding Entry.Action}" Width="150"/><DataGridTextColumn Header="级别" Binding="{Binding Entry.Kind}" Width="75"/><DataGridTextColumn Header="来源" Binding="{Binding Entry.Source}" Width="150"/><DataGridTextColumn Header="报警代码" Binding="{Binding Entry.Code}" Width="160"/><DataGridTextColumn Header="报警内容" Binding="{Binding Entry.Message}" Width="*" MinWidth="180"/></DataGrid.Columns>
  </DataGrid><TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#596B7D" IsHitTestVisible="False"/></Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0"><TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#40536A"/></Border>
 </Grid>
</UserControl>
