<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.ManualAxisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 每张轴卡固定紧凑宽度，便于多根已映射轴并排调试。 -->
    <Border Width="320"
            Margin="0,0,10,10"
            Padding="9"
            Background="White"
            BorderBrush="#C9D1D9"
            BorderThickness="1"
            CornerRadius="3">
        <StackPanel>
            <!-- 轴号和设备名称分开显示，添加位置操作放在卡片标题右侧。 -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AxisTitleText" FontSize="14" FontWeight="Bold" />
                    <TextBlock x:Name="AxisHardwareText" Margin="0,1,0,0" FontSize="10" Foreground="#68737B" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="AddPositionButton"
                        Click="AddPositionButton_Click"
                        Width="30"
                        Height="26"
                        Padding="0"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource 添加位置}">
                    <TextBlock Text="＋" FontSize="16" Foreground="#1769C2" />
                </Button>
            </Grid>

            <!-- 指示灯只绑定框架轴状态接口提供的真实数据。 -->
            <Border Background="#F3F6F9" Padding="5" Margin="0,0,0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="AlarmIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock x:Name="AlarmStatusText" Text="ERR" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="HomedIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock x:Name="HomedStatusText" Text="{DynamicResource 回零完成}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MotionStateText" Grid.Row="0" Grid.Column="2" Text="—" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="PositiveLimitIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock Text="LMT+" FontSize="10" VerticalAlignment="Center" ToolTip="{DynamicResource 正限位}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="OriginIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock x:Name="OriginStatusText" Text="ORG" FontSize="10" VerticalAlignment="Center" ToolTip="{DynamicResource 原点输入状态}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="NegativeLimitIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock Text="LMT-" FontSize="10" VerticalAlignment="Center" ToolTip="{DynamicResource 负限位}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 指令位置与反馈位置分别读取；供应商没有提供指令位置时会显示横线。 -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource 指令位置}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock x:Name="CommandPositionText" Grid.Column="1" VerticalAlignment="Center" FontSize="11" />
                <TextBlock x:Name="PositionUnitText" Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="#68737B" Margin="4,0,0,0" />
                <TextBlock Grid.Row="1" Text="{DynamicResource 反馈位置}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock x:Name="FeedbackPositionText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="11" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=PositionUnitText, Path=Text}" VerticalAlignment="Center" FontSize="10" Foreground="#68737B" Margin="4,0,0,0" />
                <TextBlock Grid.Row="2" Text="{DynamicResource 手动调试速度}" VerticalAlignment="Center" FontSize="11" />
                <TextBox x:Name="SpeedTextBox" Grid.Row="2" Grid.Column="1" Padding="3,1" VerticalContentAlignment="Center" />
                <TextBlock x:Name="SpeedUnitText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="#68737B" Margin="4,0,0,0" />
                <TextBlock Grid.Row="3" Text="{DynamicResource 寸动步长}" VerticalAlignment="Center" FontSize="11" />
                <TextBox x:Name="JogStepTextBox" Grid.Row="3" Grid.Column="1" Padding="3,1" Text="1" VerticalContentAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=PositionUnitText, Path=Text}" VerticalAlignment="Center" FontSize="10" Foreground="#68737B" Margin="4,0,0,0" />
                <TextBlock Grid.Row="4" Text="{DynamicResource 定位位置}" VerticalAlignment="Center" FontSize="11" />
                <TextBox x:Name="TargetPositionTextBox" Grid.Row="4" Grid.Column="1" Padding="3,1" Text="0" VerticalContentAlignment="Center" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ElementName=PositionUnitText, Path=Text}" VerticalAlignment="Center" FontSize="10" Foreground="#68737B" Margin="4,0,0,0" />
            </Grid>

            <!-- 点动按钮保持按下时运行；切换为寸动后，每次按下只走设定步长。 -->
            <UniformGrid Rows="3" Columns="3" Margin="0,2,0,5">
                <Button x:Name="PositiveJogButton"
                        Content="{DynamicResource 正向点动}"
                        PreviewMouseLeftButtonDown="PositiveJogButton_MouseDown"
                        PreviewMouseLeftButtonUp="JogButton_MouseUp"
                        LostMouseCapture="JogButton_LostMouseCapture"
                        Margin="1" Padding="3,4" />
                <Button x:Name="HomeButton" Content="{DynamicResource 回零}" Click="HomeButton_Click" Margin="1" Padding="3,4" />
                <ToggleButton x:Name="JogModeToggleButton" Content="{DynamicResource 连续点动}" IsChecked="True" Click="JogModeToggleButton_Click" Margin="1" Padding="3,4" />
                <Button x:Name="NegativeJogButton"
                        Content="{DynamicResource 负向点动}"
                        PreviewMouseLeftButtonDown="NegativeJogButton_MouseDown"
                        PreviewMouseLeftButtonUp="JogButton_MouseUp"
                        LostMouseCapture="JogButton_LostMouseCapture"
                        Margin="1" Padding="3,4" />
                <Button x:Name="StopButton" Content="{DynamicResource 受控停止}" Click="StopButton_Click" Margin="1" Padding="3,4" />
                <Button x:Name="ServoToggleButton" Content="{DynamicResource 伺服使能}" Click="ServoToggleButton_Click" Margin="1" Padding="3,4" />
                <Button x:Name="MoveAbsoluteButton" Content="{DynamicResource 定位}" Click="MoveAbsoluteButton_Click" Margin="1" Padding="3,4" />
                <Button x:Name="SafetyCheckButton" Content="{DynamicResource 安全条件}" Click="SafetyCheckButton_Click" Margin="1" Padding="3,4" />
                <Button x:Name="ResetAxisAlarmButton" Content="{DynamicResource 轴报警复位}" Click="ResetAxisAlarmButton_Click" Margin="1" Padding="3,4" />
            </UniformGrid>

            <!-- 加速度和减速度属于控制卡运动曲线参数，保留现场填写入口但默认收起。 -->
            <Expander Header="{DynamicResource 运动曲线参数}" Margin="0,0,0,5">
                <Grid Margin="2,4,2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource 加速度}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="AccelerationTextBox" Grid.Column="1" Padding="3,1" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource 减速度}" VerticalAlignment="Center" Margin="6,0,4,0" />
                    <TextBox x:Name="DecelerationTextBox" Grid.Column="3" Padding="3,1" />
                </Grid>
            </Expander>

            <!-- 示教位置最初为空；新增后可以改名、写入当前位置、定位或删除。 -->
            <Border BorderBrush="#DCE2E7" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 示教位置}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource 位置名称}" Foreground="#68737B" FontSize="10" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource 目标位置}" Foreground="#68737B" FontSize="10" />
                    </Grid>
                    <ItemsControl x:Name="PositionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="1,2" BorderBrush="#E6EAED" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                 LostFocus="PositionNameTextBox_LostFocus"
                                                 Padding="2,1"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="10" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Position, StringFormat={}{0:F3}}"
                                                   VerticalAlignment="Center"
                                                   Margin="3,0"
                                                   FontSize="10" />
                                        <Button Grid.Column="2" Content="{DynamicResource 写入当前位置}" Click="TeachPositionButton_Click" Margin="1" Padding="3,2" FontSize="9" />
                                        <Button Grid.Column="3" Content="{DynamicResource 定位}" Click="MoveToPositionButton_Click" Margin="1" Padding="3,2" FontSize="9" />
                                        <Button Grid.Column="4" Content="×" Click="DeletePositionButton_Click" Margin="1" Padding="3,2" FontSize="9" ToolTip="{DynamicResource 删除位置}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyPositionsText"
                               Text="{DynamicResource 暂无示教位置}"
                               Margin="2,3,0,0"
                               Foreground="#7A858D"
                               FontSize="10" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="AlarmMessageText" Margin="0,4,0,0" Foreground="#9B322C" TextWrapping="Wrap" FontSize="10" />
            <TextBlock x:Name="OperationMessageText" Margin="0,3,0,0" Foreground="#9B322C" TextWrapping="Wrap" FontSize="10" />
        </StackPanel>
    </Border>
</UserControl>
