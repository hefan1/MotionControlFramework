<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.ManualAxisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 统一轴卡中的输入框外观，方便快速辨认和填写。 -->
        <Style x:Key="AxisInputStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CAD5E0" />
        </Style>

        <!-- 统一手动操作按钮的高度和间距，避免按钮文字拥挤。 -->
        <Style x:Key="AxisActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderBrush" Value="#CAD5E0" />
            <Setter Property="Background" Value="#F7F9FB" />
        </Style>
    </UserControl.Resources>

    <!-- 卡片保持适中宽度，让多轴控件能并排显示。 -->
    <Border Width="340"
            Margin="0,0,10,10"
            Padding="10"
            Background="White"
            BorderBrush="#D4DEE8"
            BorderThickness="1"
            CornerRadius="5">
        <StackPanel>
            <!-- 标题突出设备轴名，控制卡和物理轴号作为辅助信息。 -->
            <StackPanel Margin="0,0,0,7">
                <TextBlock x:Name="AxisTitleText" FontSize="15" FontWeight="Bold" Foreground="#183653" />
                <TextBlock x:Name="AxisHardwareText" Margin="0,2,0,0" FontSize="10" Foreground="#687A8C" />
            </StackPanel>

            <!-- 把报警、回零、运动、原点和限位放在一个状态区内。 -->
            <Border Background="#F3F6F9" Padding="6" Margin="0,0,0,7" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="AlarmIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock x:Name="AlarmStatusText" Text="ERR" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="HomedIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock x:Name="HomedStatusText" Text="{DynamicResource 状态未连接}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="MotionStateText" Text="—" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ServoStatusText" Text="{DynamicResource 轴伺服状态未连接}" Margin="0,2,0,0" FontSize="9" Foreground="#52677A" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="PositiveLimitIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock Text="LMT+" FontSize="10" VerticalAlignment="Center" ToolTip="{DynamicResource 正限位}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="OriginIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock x:Name="OriginStatusText" Text="ORG" FontSize="10" VerticalAlignment="Center" ToolTip="{DynamicResource 原点输入状态}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="NegativeLimitIndicator" Width="10" Height="10" Fill="#9AA4AD" Margin="0,0,4,0" />
                        <TextBlock Text="LMT-" FontSize="10" VerticalAlignment="Center" ToolTip="{DynamicResource 负限位}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 指令位置、轴当前位置和常用手动参数按行排列，标签和单位对齐。 -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="27" />
                    <RowDefinition Height="27" />
                    <RowDefinition Height="29" />
                    <RowDefinition Height="29" />
                    <RowDefinition Height="29" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource 指令位置}" VerticalAlignment="Center" FontSize="11" Foreground="#43576A" />
                <TextBlock x:Name="CommandPositionText" Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="PositionUnitText" Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="#687A8C" Margin="5,0,0,0" />
                <TextBlock Grid.Row="1" Text="{DynamicResource 轴当前位置}" VerticalAlignment="Center" FontSize="11" Foreground="#43576A" />
                <TextBlock x:Name="FeedbackPositionText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=PositionUnitText, Path=Text}" VerticalAlignment="Center" FontSize="10" Foreground="#687A8C" Margin="5,0,0,0" />
                <TextBlock Grid.Row="2" Text="{DynamicResource 手动调试速度}" VerticalAlignment="Center" FontSize="11" Foreground="#43576A" />
                <TextBox x:Name="SpeedTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource AxisInputStyle}" />
                <TextBlock x:Name="SpeedUnitText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="#687A8C" Margin="5,0,0,0" />
                <TextBlock Grid.Row="3" Text="{DynamicResource 寸动步长}" VerticalAlignment="Center" FontSize="11" Foreground="#43576A" />
                <TextBox x:Name="JogStepTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource AxisInputStyle}" Text="1" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=PositionUnitText, Path=Text}" VerticalAlignment="Center" FontSize="10" Foreground="#687A8C" Margin="5,0,0,0" />
                <TextBlock Grid.Row="4" Text="{DynamicResource 定位位置}" VerticalAlignment="Center" FontSize="11" Foreground="#43576A" />
                <TextBox x:Name="TargetPositionTextBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource AxisInputStyle}" Text="0" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ElementName=PositionUnitText, Path=Text}" VerticalAlignment="Center" FontSize="10" Foreground="#687A8C" Margin="5,0,0,0" />
            </Grid>

            <!-- 常用运动操作使用三列布局，停止和定位按钮更醒目。 -->
            <UniformGrid Rows="3" Columns="3" Margin="-1,0,-1,7">
                <Button x:Name="PositiveJogButton"
                        Content="{DynamicResource 正向点动}"
                        PreviewMouseLeftButtonDown="PositiveJogButton_MouseDown"
                        PreviewMouseLeftButtonUp="JogButton_MouseUp"
                        LostMouseCapture="JogButton_LostMouseCapture"
                        Style="{StaticResource AxisActionButtonStyle}"
                        Background="#EAF3FC"
                        BorderBrush="#BDD5EE" />
                <Button x:Name="HomeButton" Content="{DynamicResource 回零}" Click="HomeButton_Click" Style="{StaticResource AxisActionButtonStyle}" />
                <ToggleButton x:Name="JogModeToggleButton" Content="{DynamicResource 连续点动}" IsChecked="True" Click="JogModeToggleButton_Click" Margin="2" MinHeight="30" Padding="5,4" FontSize="11" />
                <Button x:Name="NegativeJogButton"
                        Content="{DynamicResource 负向点动}"
                        PreviewMouseLeftButtonDown="NegativeJogButton_MouseDown"
                        PreviewMouseLeftButtonUp="JogButton_MouseUp"
                        LostMouseCapture="JogButton_LostMouseCapture"
                        Style="{StaticResource AxisActionButtonStyle}"
                        Background="#EAF3FC"
                        BorderBrush="#BDD5EE" />
                <Button x:Name="StopButton"
                        Content="{DynamicResource 受控停止}"
                        Click="StopButton_Click"
                        Style="{StaticResource AxisActionButtonStyle}"
                        Background="#FCEDEA"
                        BorderBrush="#E8C1BB"
                        Foreground="#9C3429" />
                <Button x:Name="ServoToggleButton" Content="{DynamicResource 伺服使能}" Click="ServoToggleButton_Click" Style="{StaticResource AxisActionButtonStyle}" />
                <Button x:Name="MoveAbsoluteButton"
                        Content="{DynamicResource 定位}"
                        Click="MoveAbsoluteButton_Click"
                        Style="{StaticResource AxisActionButtonStyle}"
                        Background="#E8F1FC"
                        BorderBrush="#B9D1F0"
                        Foreground="#175BA6" />
                <Button x:Name="SafetyCheckButton" Content="{DynamicResource 安全条件}" Click="SafetyCheckButton_Click" Style="{StaticResource AxisActionButtonStyle}" />
                <Button x:Name="ResetAxisAlarmButton" Content="{DynamicResource 轴报警复位}" Click="ResetAxisAlarmButton_Click" Style="{StaticResource AxisActionButtonStyle}" />
            </UniformGrid>

            <!-- 运动曲线参数不常用，默认收起，避免挤占手动操作空间。 -->
            <Expander Header="{DynamicResource 运动曲线参数}" Margin="0,0,0,6" FontSize="11">
                <Grid Margin="2,5,2,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource 加速度}" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox x:Name="AccelerationTextBox" Grid.Column="1" Style="{StaticResource AxisInputStyle}" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource 减速度}" VerticalAlignment="Center" Margin="7,0,5,0" />
                    <TextBox x:Name="DecelerationTextBox" Grid.Column="3" Style="{StaticResource AxisInputStyle}" />
                </Grid>
            </Expander>

            <!-- 示教位置最初为空；新增后可改名、直接编辑坐标、写入当前位置、定位或删除。 -->
            <Border BorderBrush="#DCE4EC" BorderThickness="0,1,0,0" Padding="0,7,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource 示教位置}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#284661" />
                        <Button Grid.Column="1"
                                x:Name="AddPositionButton"
                                Click="AddPositionButton_Click"
                                ToolTip="{DynamicResource 添加位置}"
                                Style="{StaticResource AxisActionButtonStyle}"
                                MinHeight="26"
                                Margin="0"
                                Padding="7,2"
                                Background="#EEF5FC"
                                BorderBrush="#C2D8EF"
                                Foreground="#175BA6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" Margin="0,0,3,0" />
                                <TextBlock Text="{DynamicResource 添加位置}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="1,0,1,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource 位置名称}" Foreground="#687A8C" FontSize="10" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource 目标位置}" Foreground="#687A8C" FontSize="10" />
                        <TextBlock Grid.Column="2" Text="{DynamicResource 写入短标签}" Foreground="#687A8C" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{DynamicResource 定位}" Foreground="#687A8C" FontSize="10" HorizontalAlignment="Center" />
                    </Grid>
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PositionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="1,3" BorderBrush="#E8EDF2" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                     LostFocus="PositionNameTextBox_LostFocus"
                                                     Style="{StaticResource AxisInputStyle}"
                                                     MinHeight="24"
                                                     Padding="3,1"
                                                     FontSize="10" />
                                            <TextBox x:Name="PositionValueTextBox"
                                                     Grid.Column="1"
                                                     Text="{Binding Position, Mode=OneWay, StringFormat={}{0:R}}"
                                                     LostFocus="PositionValueTextBox_LostFocus"
                                                     KeyDown="PositionValueTextBox_KeyDown"
                                                     Style="{StaticResource AxisInputStyle}"
                                                     MinHeight="24"
                                                     Padding="3,1"
                                                     Margin="1"
                                                     FontSize="10"
                                                     ToolTip="{DynamicResource 直接编辑目标位置}" />
                                            <Button Grid.Column="2" Content="{DynamicResource 写入短标签}" Click="TeachPositionButton_Click" Margin="1" Padding="2,1" MinHeight="24" FontSize="10" ToolTip="{DynamicResource 写入当前位置}" />
                                            <Button Grid.Column="3" Content="{DynamicResource 定位}" Click="MoveToPositionButton_Click" Margin="1" Padding="2,1" MinHeight="24" FontSize="10" />
                                            <Button Grid.Column="4" Content="×" Click="DeletePositionButton_Click" Margin="1" Padding="1" MinHeight="24" FontSize="10" ToolTip="{DynamicResource 删除位置}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyPositionsText"
                               Text="{DynamicResource 暂无示教位置}"
                               Margin="2,4,0,0"
                               Foreground="#7A858D"
                               FontSize="10" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="AlarmMessageText" Margin="0,5,0,0" Foreground="#9B322C" TextWrapping="Wrap" FontSize="10" />
            <TextBlock x:Name="OperationMessageText" Margin="0,3,0,0" Foreground="#52677A" TextWrapping="Wrap" FontSize="10" />
        </StackPanel>
    </Border>
</UserControl>
