<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.IoMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F7">
    <UserControl.Resources>
        <DataTemplate x:Key="DigitalInputChannelTemplate">
            <Border Height="30"
                    Background="#F8FAFB"
                    BorderBrush="#E5E9ED"
                    BorderThickness="0,0,0,1"
                    ToolTip="{Binding StateText}">
                <Grid Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0"
                             Width="14"
                             Height="14"
                             Fill="{Binding IndicatorBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Address}"
                               Foreground="#54616A"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayName}"
                               Foreground="#20282E"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayName}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DigitalOutputChannelTemplate">
            <Border Height="30"
                    Background="#F8FAFB"
                    BorderBrush="#E5E9ED"
                    BorderThickness="0,0,0,1"
                    ToolTip="{Binding StateText}">
                <Grid Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Tag="{Binding}"
                            IsEnabled="{Binding CanToggleOutput}"
                            Click="OutputIndicator_Click"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{DynamicResource DO状态灯操作提示}">
                        <Ellipse Width="14"
                                 Height="14"
                                 Fill="{Binding IndicatorBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Address}"
                               Foreground="#54616A"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayName}"
                               Foreground="#20282E"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayName}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DigitalInputColumnTemplate">
            <Border Margin="3"
                    Padding="3"
                    BorderBrush="#D7DFE5"
                    BorderThickness="1"
                    CornerRadius="3"
                    Background="White">
                <ItemsControl ItemsSource="{Binding}"
                              ItemTemplate="{StaticResource DigitalInputChannelTemplate}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DigitalOutputColumnTemplate">
            <Border Margin="3"
                    Padding="3"
                    BorderBrush="#D7DFE5"
                    BorderThickness="1"
                    CornerRadius="3"
                    Background="White">
                <ItemsControl ItemsSource="{Binding}"
                              ItemTemplate="{StaticResource DigitalOutputChannelTemplate}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource IO监控页面说明}"
                   FontSize="13"
                   Foreground="#555B60"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource 刷新状态}"
                    Padding="14,5"
                    Click="RefreshButton_Click" />
            <TextBlock x:Name="MonitorRangeText"
                       DockPanel.Dock="Right"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="#54616A"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MonitorStatusText"
                       VerticalAlignment="Center"
                       Foreground="#315F8C"
                       TextWrapping="Wrap" />
        </DockPanel>

        <TabControl x:Name="MonitorTabs"
                    Grid.Row="2"
                    SelectionChanged="MonitorTabs_SelectionChanged">
            <TabItem x:Name="DigitalInputTab" Header="{DynamicResource 数字输入}">
                <Grid x:Name="DigitalInputViewport"
                      SizeChanged="ChannelViewport_SizeChanged">
                    <ListBox x:Name="DigitalInputList"
                             Background="White"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.ScrollChanged="ChannelColumns_ScrollChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="260" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Top" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}"
                                                  ContentTemplate="{StaticResource DigitalInputColumnTemplate}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoDigitalInputsText"
                               Text="{DynamicResource IO监控没有可读通道}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#7A858D"
                               Visibility="Collapsed" />
                </Grid>
            </TabItem>

            <TabItem x:Name="DigitalOutputTab" Header="{DynamicResource 数字输出}">
                <Grid x:Name="DigitalOutputViewport"
                      SizeChanged="ChannelViewport_SizeChanged">
                    <ListBox x:Name="DigitalOutputList"
                             Background="White"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.ScrollChanged="ChannelColumns_ScrollChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="260" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Top" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}"
                                                  ContentTemplate="{StaticResource DigitalOutputColumnTemplate}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoDigitalOutputsText"
                               Text="{DynamicResource IO监控没有可读通道}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#7A858D"
                               Visibility="Collapsed" />
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="OperationMessageText"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="#9B322C"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
