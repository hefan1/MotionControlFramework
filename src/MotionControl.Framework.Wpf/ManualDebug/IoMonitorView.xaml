<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.IoMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="IoMonitorButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#33485F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#82B5F5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E1E6EC" />
                                <Setter Property="Foreground" Value="#9AA4B1" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IoMonitorOutlineButton" TargetType="Button" BasedOn="{StaticResource IoMonitorButton}">
            <Setter Property="Foreground" Value="#176BD0" />
            <Setter Property="BorderBrush" Value="#9FC5FA" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1" />
                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="#D9E0E8"
                                    BorderThickness="1"
                                    CornerRadius="0,0,6,6">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#40536A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="#EDF3F9"
                                BorderBrush="#D9E0E8"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#E5EFFA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="White" />
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter Property="Foreground" Value="#176BD0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9AA4B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DigitalInputChannelTemplate">
            <Border Height="30"
                    BorderThickness="0,0,0,1"
                    ToolTip="{Binding StateText}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F7F9FC" />
                        <Setter Property="BorderBrush" Value="#E6EBF1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationTarget}" Value="True">
                                <Setter Property="Background" Value="#FFF5CC" />
                                <Setter Property="BorderBrush" Value="#D6A52E" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0"
                             Width="14"
                             Height="14"
                             Fill="{Binding IndicatorBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Address}"
                               Foreground="#40536A"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayName}"
                               Foreground="#26384D"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayName}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding StateText}"
                               Foreground="{Binding IndicatorBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StateText}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DigitalOutputChannelTemplate">
            <Border Height="30" BorderThickness="0,0,0,1" MouseLeftButtonDown="OutputRow_SelectFeedback" Cursor="Hand" ToolTip="{DynamicResource IO反馈选择提示}">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F7F9FC" /><Setter Property="BorderBrush" Value="#E6EBF1" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsFeedbackSelection}" Value="True"><Setter Property="Background" Value="#E3F0FC" /><Setter Property="BorderBrush" Value="#7CB1E8" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Tag="{Binding}" IsEnabled="{Binding CanToggleOutput}" Click="OutputIndicator_Click" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{DynamicResource DO状态灯操作提示}">
                        <Ellipse Width="14" Height="14" Fill="{Binding IndicatorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Address}" Foreground="#40536A" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Foreground="#26384D" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                    <TextBlock Grid.Column="3" Text="{Binding StateText}" Foreground="{Binding IndicatorBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateText}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DigitalInputColumnTemplate">
            <Border Margin="3"
                    Padding="4"
                    BorderBrush="#D9E0E8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White">
                <ItemsControl ItemsSource="{Binding}"
                              ItemTemplate="{StaticResource DigitalInputChannelTemplate}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DigitalOutputColumnTemplate">
            <Border Margin="3"
                    Padding="4"
                    BorderBrush="#D9E0E8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White">
                <ItemsControl ItemsSource="{Binding}"
                              ItemTemplate="{StaticResource DigitalOutputChannelTemplate}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,9"
                Margin="0,0,0,10"
                Background="#F7F9FC"
                BorderBrush="#D8E2EE"
                BorderThickness="1"
                CornerRadius="6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                    Content="{DynamicResource 刷新状态}"
                    MinWidth="88"
                    Style="{StaticResource IoMonitorOutlineButton}"
                    Click="RefreshButton_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="MonitorStatusText"
                               Foreground="#315F8C"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MonitorRangeText"
                               Margin="0,4,8,0"
                               Foreground="#596B7D"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MonitorTabs"
                    Grid.Row="1"
                    SelectionChanged="MonitorTabs_SelectionChanged">
            <TabItem x:Name="DigitalInputTab" Header="{DynamicResource 数字输入}">
                <Grid x:Name="DigitalInputViewport"
                      SizeChanged="ChannelViewport_SizeChanged">
                    <ListBox x:Name="DigitalInputList"
                             Background="White"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.ScrollChanged="ChannelColumns_ScrollChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="260" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Top" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}"
                                                  ContentTemplate="{StaticResource DigitalInputColumnTemplate}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoDigitalInputsText"
                               Text="{DynamicResource IO监控没有可读通道}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#7A858D"
                               Visibility="Collapsed" />
                </Grid>
            </TabItem>

            <TabItem x:Name="DigitalOutputTab" Header="{DynamicResource 数字输出}">
                <Grid x:Name="DigitalOutputViewport" SizeChanged="ChannelViewport_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="FeedbackPanelColumn" Width="300" /></Grid.ColumnDefinitions>
                    <ListBox x:Name="DigitalOutputList"
                             Background="White"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.ScrollChanged="ChannelColumns_ScrollChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="260" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Top" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}"
                                                  ContentTemplate="{StaticResource DigitalOutputColumnTemplate}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoDigitalOutputsText"
                               Text="{DynamicResource IO监控没有可读通道}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#7A858D"
                               Visibility="Collapsed" />
                    <Border x:Name="FeedbackPanel" Grid.Column="1" Margin="8,3,0,3" Padding="8" Background="White" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource IO反馈输入标题}" Foreground="#26384D" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="FeedbackSelectionText" Foreground="#596B7D" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid>
                                <TextBlock x:Name="FeedbackEmptyText" Text="{DynamicResource IO反馈无关联}" Foreground="#7A858D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="FeedbackDetails"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Height="30" Background="#F7F9FC" BorderBrush="#E6EBF1" BorderThickness="0,0,0,1">
                                            <Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="14" Height="14" Fill="{Binding IndicatorBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Address}" Foreground="#40536A" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#26384D" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{Binding IndicatorBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding State}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="OperationMessageText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="#A33B35"
                   FontSize="12"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
