<Window x:Class="MotionControl.Framework.Wpf.ManualDebug.ManualAxisIoAssociationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource 关联IO设置标题}"
        Width="430"
        SizeToContent="Height"
        MinHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource 关联IO设置说明}"
                   TextWrapping="Wrap"
                   Foreground="#52677A"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource IO类型}" VerticalAlignment="Center" />
            <ComboBox x:Name="PointTypeComboBox" Grid.Column="1" MinHeight="28"
                      SelectionChanged="PointTypeComboBox_SelectionChanged">
                <ComboBoxItem Content="DI" Tag="DigitalInput" />
                <ComboBoxItem Content="DO" Tag="DigitalOutput" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource 逻辑IO名称}" VerticalAlignment="Center" />
            <ComboBox x:Name="PointNameComboBox" Grid.Column="1" MinHeight="28"
                      DisplayMemberPath="Name" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource 显示名称}" VerticalAlignment="Center" />
            <TextBox x:Name="DisplayNameTextBox" Grid.Column="1" MinHeight="28"
                     Padding="5,3" VerticalContentAlignment="Center" />
        </Grid>

        <Border x:Name="OutputActionPanel" Grid.Row="4" Padding="10" Margin="0,0,0,10"
                Background="White" BorderBrush="#D4DEE8" BorderThickness="1" CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{DynamicResource DO按钮文字说明}" Foreground="#52677A"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource 逻辑ON按钮名称}" VerticalAlignment="Center" />
                    <TextBox x:Name="OnActionNameTextBox" Grid.Column="1" MinHeight="28"
                             Padding="5,3" VerticalContentAlignment="Center" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource 逻辑OFF按钮名称}" VerticalAlignment="Center" />
                    <TextBox x:Name="OffActionNameTextBox" Grid.Column="1" MinHeight="28"
                             Padding="5,3" VerticalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationMessageText" Grid.Row="5" Foreground="#B3362D"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource 取消修改}" MinWidth="82" Margin="0,0,8,0"
                    Padding="10,5" IsCancel="True" />
            <Button Content="{DynamicResource 保存配置}" MinWidth="82" Padding="10,5"
                    IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
