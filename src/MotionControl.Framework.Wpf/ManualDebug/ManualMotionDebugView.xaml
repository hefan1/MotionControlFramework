<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.ManualMotionDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F7">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource 手动调试说明}"
                       FontSize="14"
                       Foreground="#555B60"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <Border Background="White" BorderBrush="#D9DDE0" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 轴手动}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource 逻辑轴}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="AxisSelector" Width="190" SelectionChanged="AxisSelector_SelectionChanged" />
                        <TextBlock x:Name="MachineStateText" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#555B60" />
                    </WrapPanel>
                    <TextBlock x:Name="AxisStatusText" Margin="0,10,0,0" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#33383C" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ServoEnableButton" Content="{DynamicResource 伺服使能}" Click="ServoEnableButton_Click" Margin="0,0,8,8" Padding="12,6" />
                        <Button Content="{DynamicResource 伺服关闭}" Click="ServoDisableButton_Click" Margin="0,0,8,8" Padding="12,6" />
                        <Button Content="{DynamicResource 回零}" Click="HomeButton_Click" Margin="0,0,8,8" Padding="12,6" />
                        <Button Content="{DynamicResource 轴报警复位}" Click="ResetAxisAlarmButton_Click" Margin="0,0,8,8" Padding="12,6" />
                        <Button Content="{DynamicResource 受控停止}" Click="StopButton_Click" Margin="0,0,8,8" Padding="12,6" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource 速度}" VerticalAlignment="Center" Margin="0,0,6,8" />
                        <TextBox x:Name="SpeedTextBox" Text="5" Width="72" Margin="0,0,12,8" Padding="5" />
                        <TextBlock Text="{DynamicResource 加速度}" VerticalAlignment="Center" Margin="0,0,6,8" />
                        <TextBox x:Name="AccelerationTextBox" Text="10" Width="72" Margin="0,0,12,8" Padding="5" />
                        <TextBlock Text="{DynamicResource 减速度}" VerticalAlignment="Center" Margin="0,0,6,8" />
                        <TextBox x:Name="DecelerationTextBox" Text="10" Width="72" Margin="0,0,16,8" Padding="5" />
                        <TextBlock Text="{DynamicResource 目标位置}" VerticalAlignment="Center" Margin="0,0,6,8" />
                        <TextBox x:Name="TargetPositionTextBox" Text="0" Width="90" Margin="0,0,8,8" Padding="5" />
                        <Button Content="{DynamicResource 绝对定位}" Click="MoveAbsoluteButton_Click" Margin="0,0,8,8" Padding="12,6" />
                        <Button Content="{DynamicResource 相对移动}" Click="MoveRelativeButton_Click" Margin="0,0,8,8" Padding="12,6" />
                    </WrapPanel>
                    <WrapPanel Margin="0,2,0,0">
                        <TextBlock Text="{DynamicResource 按住点动}" VerticalAlignment="Center" Margin="0,0,12,8" />
                        <Button Content="{DynamicResource 负向点动}" PreviewMouseLeftButtonDown="NegativeJogButton_MouseDown" PreviewMouseLeftButtonUp="JogButton_MouseUp" LostMouseCapture="JogButton_LostMouseCapture" Margin="0,0,8,8" Padding="14,6" />
                        <Button Content="{DynamicResource 正向点动}" PreviewMouseLeftButtonDown="PositiveJogButton_MouseDown" PreviewMouseLeftButtonUp="JogButton_MouseUp" LostMouseCapture="JogButton_LostMouseCapture" Margin="0,0,8,8" Padding="14,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#D9DDE0" BorderThickness="1" CornerRadius="4" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource 数字输入}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel x:Name="DigitalInputsPanel" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE0" BorderThickness="1" CornerRadius="4" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource 数字输出}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel x:Name="DigitalOutputsPanel" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="OperationMessageText" Margin="0,12,0,0" Foreground="#9B322C" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource 急停软件提示}" Margin="0,8,0,0" Foreground="#8A5A00" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
