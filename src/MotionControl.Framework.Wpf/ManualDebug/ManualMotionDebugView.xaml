<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.ManualMotionDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F7">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock x:Name="MachineStateText" Margin="2,0,0,6" Foreground="#555B60" />
            <TextBlock x:Name="NoMappedAxesText"
                       Text="{DynamicResource 尚未配置轴}"
                       Foreground="#7A858D"
                       Visibility="Collapsed" />
            <WrapPanel x:Name="AxisCardsPanel" />
            <TextBlock x:Name="OperationMessageText" Margin="0,8,0,0" Foreground="#9B322C" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource 急停软件提示}" Margin="0,6,0,0" Foreground="#8A5A00" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
