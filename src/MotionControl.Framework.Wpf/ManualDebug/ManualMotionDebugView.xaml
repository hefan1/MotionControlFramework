<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.ManualMotionDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F7">
    <ScrollViewer x:Name="AxisCardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Border x:Name="NoMappedAxesPanel"
                    Margin="0,0,0,10"
                    Padding="16"
                    Background="White"
                    BorderBrush="#D4DEE8"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="NoMappedAxesText"
                               Text="{DynamicResource 尚未配置轴}"
                               Foreground="#53677A"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <Button Content="{DynamicResource 打开轴映射配置}"
                            Click="OpenAxisMappingButton_Click"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            MinHeight="34"
                            Padding="12,5"
                            Background="#E8F1FC"
                            BorderBrush="#B9D1F0"
                            Foreground="#175BA6" />
                </StackPanel>
            </Border>
            <WrapPanel x:Name="AxisCardsPanel" />
            <TextBlock x:Name="OperationMessageText" Margin="0,8,0,0" Foreground="#9B322C" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
