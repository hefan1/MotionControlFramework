<UserControl x:Class="MotionControl.Framework.Wpf.ManualDebug.ManualIoDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F7">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock x:Name="MachineStateText"
                       Margin="0,0,0,8"
                       VerticalAlignment="Center"
                       Foreground="#596B7D"
                       FontSize="12" />
            <Border x:Name="NoMappedIoPanel"
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D4DEE8"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource IO手动未配置映射说明}"
                               VerticalAlignment="Center"
                               Foreground="#53677A"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="{DynamicResource 打开IO映射配置}"
                            Click="OpenIoMappingButton_Click"
                            Margin="12,0,0,0"
                            MinHeight="34"
                            Padding="12,5"
                            Background="#E8F1FC"
                            BorderBrush="#B9D1F0"
                            Foreground="#175BA6" />
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#D9DDE0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource 数字输入}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel x:Name="DigitalInputsPanel" />
                        <TextBlock x:Name="NoInputsText" Text="{DynamicResource 没有配置DI}" Foreground="#7A858D" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource 数字输出}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel x:Name="DigitalOutputsPanel" />
                        <TextBlock x:Name="NoOutputsText" Text="{DynamicResource 没有配置DO}" Foreground="#7A858D" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="OperationMessageText" Margin="0,8,0,0" Foreground="#9B322C" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource 急停软件提示}" Margin="0,6,0,0" Foreground="#8A5A00" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
