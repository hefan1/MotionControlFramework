<UserControl x:Class="MotionControl.Framework.Wpf.Monitoring.AxisMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <Grid Margin="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,9"
                Background="#F7F9FC"
                BorderBrush="#D8E2EE"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonitorStatusText"
                           Foreground="#40536A"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource 轴监控自动刷新说明}"
                           Foreground="#596B7D"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource 轴筛选搜索}" VerticalAlignment="Center"/>
                <TextBox x:Name="AxisSearchBox" Width="200" Margin="8,0" TextChanged="AxisFilterChanged"/>
                <CheckBox x:Name="AttentionOnlyBox" Content="{DynamicResource 轴筛选仅异常未知}" VerticalAlignment="Center" Checked="AxisFilterToggled" Unchecked="AxisFilterToggled"/>
                <Button x:Name="ClearAxisFilterButton" Content="{DynamicResource 轴筛选清除}" Click="ClearAxisFilter_Click" Margin="8,0"/>
                <TextBlock x:Name="AxisMatchText" VerticalAlignment="Center"/>
            </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="1"
                Background="White"
                BorderBrush="#D9E0E8"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="AxisStatusGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      HorizontalGridLinesBrush="#E6EBF1"
                      IsReadOnly="True"
                      ItemsSource="{Binding}"
                      RowBackground="White"
                      AlternatingRowBackground="#F7F9FC"
                      RowHeight="38"
                      BorderThickness="0"
                      Background="White"
                      Foreground="#26384D"
                      FontSize="12"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F6FA" />
                        <Setter Property="Foreground" Value="#40536A" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="6,8" />
                        <Setter Property="BorderBrush" Value="#D9E0E8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="ToolTip" Value="{Binding ReadErrorMessage}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E5EFFA" />
                                <Setter Property="Foreground" Value="#26384D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
