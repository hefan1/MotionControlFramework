<UserControl x:Class="MotionControl.Framework.Wpf.Configuration.IoMappingConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="IoMappingTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="IoMappingComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="IoMappingButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#33485F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="IoMappingPrimaryButton" TargetType="Button" BasedOn="{StaticResource IoMappingButton}">
            <Setter Property="Background" Value="#2375D1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2375D1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="IoMappingGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EBF1" />
            <Setter Property="VerticalGridLinesBrush" Value="#E6EBF1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="ColumnHeaderHeight" Value="33" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#293B50" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="IsReadOnly" Value="False" />
        </Style>
        <Style x:Key="IoMappingGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="33" />
            <Setter Property="Background" Value="#EEF3F8" />
            <Setter Property="Foreground" Value="#34465A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="5,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="#DCE4ED" />
        </Style>
        <Style x:Key="IoMappingGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#293B50" />
            <Setter Property="BorderBrush" Value="#E6EBF1" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="">
                    <Setter Property="Background" Value="#F5F7FA" />
                    <Setter Property="Foreground" Value="#8793A1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                    <Setter Property="Background" Value="#F5F7FA" />
                    <Setter Property="Foreground" Value="#8793A1" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FD" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDEBFC" />
                    <Setter Property="Foreground" Value="#213F62" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IoMappingGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDEBFC" />
                    <Setter Property="Foreground" Value="#213F62" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IoMappingGridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="2,0" />
        </Style>
        <Style x:Key="IoMappingGridTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IoMappingGridComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" />
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Path Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Width="8" Height="4" Stretch="Fill" Fill="#66788C"
                                  Data="M 0 0 L 4 4 L 8 0 Z" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#CAD5E2" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F5F9" />
                                <Setter Property="Foreground" Value="#8A96A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IoMappingCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,10" Margin="0,0,0,10"
                Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource IO映射说明}"
                           VerticalAlignment="Center" Margin="0,0,18,0" FontSize="11"
                           Foreground="#718096" TextWrapping="Wrap" />
                <Border Grid.Column="1" Padding="9,6" Background="#EAF3FF" CornerRadius="4">
                    <TextBlock Text="{DynamicResource IO映射连接与输出说明}" FontSize="11"
                               Foreground="#37638F" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="8,5"
                        Background="#EAF3FF" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IoCapabilityStatusText" Text="{DynamicResource 控制卡Io数量未连接}"
                                   VerticalAlignment="Center" FontSize="11" Foreground="#37638F"
                                   TextWrapping="Wrap" />
                        <Button x:Name="RefreshIoCapabilitiesButton" Grid.Column="1"
                                Content="{DynamicResource 刷新控制卡Io数量}"
                                Click="RefreshIoCapabilitiesButton_Click"
                                Style="{StaticResource IoMappingButton}" Height="28" Margin="10,0,0,0"
                                IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Background="White"
                    BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource 数字输入映射}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#24364B" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding DigitalInputs.Count}" FontSize="11" Foreground="#718096" />
                                <TextBlock Text="{DynamicResource 个通道}" Margin="3,0,0,0" FontSize="11" Foreground="#718096" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RemoveInputButton" Content="{DynamicResource 清空逻辑名}" Click="RemoveInputButton_Click"
                                    Style="{StaticResource IoMappingButton}" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="DigitalInputsGrid" Grid.Row="1" ItemsSource="{Binding DigitalInputs}"
                              Style="{StaticResource IoMappingGrid}" SelectionMode="Single" SelectionUnit="FullRow"
                              CellEditEnding="DigitalInputsGrid_CellEditEnding"
                              SelectionChanged="MappingGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <!-- WPF Track 会用此系统资源的一半作为滑块最小长度；4096 路通道时仍保留易拖动的滑块。 -->
                            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">192</sys:Double>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource IoMappingGridHeader}" />
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource IoMappingGridRow}" />
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource IoMappingGridCell}" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource 逻辑名称}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="1.2*" ElementStyle="{StaticResource IoMappingGridCellText}"
                                                EditingElementStyle="{StaticResource IoMappingGridTextBox}" />
                            <DataGridTemplateColumn Header="{DynamicResource 控制卡编号}" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ControllerId}" Style="{StaticResource IoMappingGridCellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ControllerIds, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding ControllerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource IoMappingGridComboBox}" Margin="2,1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource 物理通道}" Binding="{Binding Channel, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                Width="78" ElementStyle="{StaticResource IoMappingGridCellText}"
                                                EditingElementStyle="{StaticResource IoMappingGridTextBox}" />
                            <DataGridTemplateColumn Header="{DynamicResource 有效电平}" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{DynamicResource 高电平有效}"
                                                  ToolTip="{DynamicResource 低电平有效提示}"
                                                  IsChecked="{Binding ActiveHigh, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="10" Background="White"
                    BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource 数字输出映射}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#24364B" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding DigitalOutputs.Count}" FontSize="11" Foreground="#718096" />
                                <TextBlock Text="{DynamicResource 个通道}" Margin="3,0,0,0" FontSize="11" Foreground="#718096" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="FeedbackAssociationButton" Content="{DynamicResource IO反馈关联}" Click="FeedbackAssociationButton_Click"
                                    Style="{StaticResource IoMappingButton}" Margin="4,0,0,0" />
                            <Button x:Name="RemoveOutputButton" Content="{DynamicResource 清空逻辑名}" Click="RemoveOutputButton_Click"
                                    Style="{StaticResource IoMappingButton}" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="DigitalOutputsGrid" Grid.Row="1" ItemsSource="{Binding DigitalOutputs}"
                              Style="{StaticResource IoMappingGrid}" SelectionMode="Single" SelectionUnit="FullRow"
                              CellEditEnding="DigitalOutputsGrid_CellEditEnding"
                              SelectionChanged="MappingGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <!-- WPF Track 会用此系统资源的一半作为滑块最小长度；4096 路通道时仍保留易拖动的滑块。 -->
                            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">192</sys:Double>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource IoMappingGridHeader}" />
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource IoMappingGridRow}" />
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource IoMappingGridCell}" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource 逻辑名称}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="1.2*" ElementStyle="{StaticResource IoMappingGridCellText}"
                                                EditingElementStyle="{StaticResource IoMappingGridTextBox}" />
                            <DataGridTemplateColumn Header="{DynamicResource 控制卡编号}" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ControllerId}" Style="{StaticResource IoMappingGridCellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ControllerIds, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding ControllerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource IoMappingGridComboBox}" Margin="2,1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource 物理通道}" Binding="{Binding Channel, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                Width="78" ElementStyle="{StaticResource IoMappingGridCellText}"
                                                EditingElementStyle="{StaticResource IoMappingGridTextBox}" />
                            <DataGridTemplateColumn Header="{DynamicResource 有效电平}" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{DynamicResource 高电平有效}"
                                                  ToolTip="{DynamicResource 低电平有效提示}"
                                                  IsChecked="{Binding ActiveHigh, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ConfigurationStatusText" Text="{DynamicResource IO映射尚未保存}"
                           FontSize="11" Foreground="#586B80" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, ElementName=ConfigurationFileText}" />
                <TextBlock x:Name="ConfigurationFileText" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CheckMappingButton" Content="{DynamicResource 检查映射}" Click="CheckMappingButton_Click"
                        Style="{StaticResource IoMappingButton}" MinWidth="96" Margin="0,0,8,0" />
                <Button x:Name="SaveConfigurationButton" Content="{DynamicResource 保存配置}" Click="SaveConfigurationButton_Click"
                        Style="{StaticResource IoMappingPrimaryButton}" MinWidth="108" Margin="0,0,8,0" />
                <Button x:Name="CancelChangesButton" Content="{DynamicResource 取消修改}" Click="CancelChangesButton_Click"
                        Style="{StaticResource IoMappingButton}" MinWidth="96" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
