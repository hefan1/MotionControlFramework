<UserControl x:Class="MotionControl.Framework.Wpf.Configuration.SafetyInterlockConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520" Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="SafetyInterlockButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="#244A73" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C7D7E8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SafetyInterlockComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C7D7E8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="SafetyContentScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>


        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource 设备控制与安全联锁标题}" FontSize="17" FontWeight="SemiBold"
                       Foreground="#183B63" />
            <TextBlock Text="{DynamicResource 设备控制与安全联锁说明}" Margin="0,4,0,0" FontSize="11"
                       Foreground="#667A91" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Padding="14" Background="#F7F9FC"
                BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource 整机操作按钮输入}" FontWeight="SemiBold"
                           Foreground="#26384D" Margin="0,0,0,8" />
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StartInputLabel" Text="{DynamicResource 现场启动按钮}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#40536A" />
                    <StackPanel Grid.Column="1"><ComboBox x:Name="StartInputBox" ItemsSource="{Binding DigitalInputNames}"
                              Text="{Binding StartInputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" IsTextSearchEnabled="True"
                              Style="{StaticResource SafetyInterlockComboBox}" />
<TextBlock Text="{DynamicResource 安全联锁启动行为}" TextWrapping="Wrap" Foreground="#40536A" Margin="0,4,0,0" />
<TextBlock Text="{Binding StartMappingSummary}" TextWrapping="Wrap" Foreground="#596B7D" Margin="0,4,0,0" />
</StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PauseInputLabel" Text="{DynamicResource 现场停止按钮}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#40536A" />
                    <StackPanel Grid.Column="1"><ComboBox x:Name="PauseInputBox" ItemsSource="{Binding DigitalInputNames}"
                              Text="{Binding PauseInputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" IsTextSearchEnabled="True"
                              Style="{StaticResource SafetyInterlockComboBox}" />
<TextBlock Text="{DynamicResource 安全联锁暂停行为}" TextWrapping="Wrap" Foreground="#40536A" Margin="0,4,0,0" />
<TextBlock Text="{Binding PauseMappingSummary}" TextWrapping="Wrap" Foreground="#596B7D" Margin="0,4,0,0" />
</StackPanel>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResetInputLabel" Text="{DynamicResource 现场复位按钮}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#40536A" />
                    <StackPanel Grid.Column="1"><ComboBox x:Name="ResetInputBox" ItemsSource="{Binding DigitalInputNames}"
                              Text="{Binding ResetInputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" IsTextSearchEnabled="True"
                              Style="{StaticResource SafetyInterlockComboBox}" />
<TextBlock Text="{DynamicResource 安全联锁复位行为}" TextWrapping="Wrap" Foreground="#40536A" Margin="0,4,0,0" />
<TextBlock Text="{Binding ResetMappingSummary}" TextWrapping="Wrap" Foreground="#596B7D" Margin="0,4,0,0" />
</StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12"
                Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EmergencyStopInputLabel" Text="{DynamicResource 安全联锁输入名称}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="#40536A" />
                <StackPanel Grid.Column="1"><ComboBox x:Name="EmergencyStopInputBox" ItemsSource="{Binding DigitalInputNames}"
                          Text="{Binding EmergencyStopInputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" IsTextSearchEnabled="True"
                          Style="{StaticResource SafetyInterlockComboBox}" />
<TextBlock Text="{DynamicResource 安全联锁软件保护行为}" TextWrapping="Wrap" Foreground="#40536A" Margin="0,4,0,0" />
<TextBlock Text="{Binding EmergencyStopMappingSummary}" TextWrapping="Wrap" Foreground="#596B7D" Margin="0,4,0,0" />
</StackPanel>
                <Button Grid.Column="2" Content="{DynamicResource 安全联锁刷新DI}"
                        Click="RefreshInputNamesButton_Click" Style="{StaticResource SafetyInterlockButton}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,10" Padding="12"
                Background="#FFF8E8" BorderBrush="#F0D59A" BorderThickness="1" CornerRadius="5"
                VerticalAlignment="Top">
            <StackPanel><TextBlock Text="{DynamicResource 安全联锁暂停语义说明}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#765515" /><TextBlock Text="{DynamicResource 设备控制按钮注意事项}" FontSize="12"
                       Foreground="#765515" TextWrapping="Wrap" /></StackPanel>
        </Border>

            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding UnsavedChangesSummary}" TextWrapping="Wrap" Foreground="#845B0A" Margin="0,0,0,4" />
                <TextBlock x:Name="ConfigurationStatusText" FontSize="11" Foreground="#52708F"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ConfigurationFileText" Margin="0,4,0,0" FontSize="10"
                           Foreground="#8190A3" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SaveSafetyButton" Content="{DynamicResource 安全联锁保存配置}" Click="SaveConfigurationButton_Click"
                        Style="{StaticResource SafetyInterlockButton}" />
                <Button x:Name="CancelSafetyButton" Content="{DynamicResource 安全联锁取消修改}" Click="CancelChangesButton_Click"
                        Style="{StaticResource SafetyInterlockButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
