<UserControl x:Class="MotionControl.Framework.Wpf.Configuration.AxisMappingConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="AxisMappingTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F5F9" />
                                <Setter Property="Foreground" Value="#8A96A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AxisMappingComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" />
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Path Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Width="8" Height="4" Stretch="Fill" Fill="#66788C"
                                  Data="M 0 0 L 4 4 L 8 0 Z" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#CAD5E2" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F5F9" />
                                <Setter Property="Foreground" Value="#8A96A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AxisMappingFieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#40536A" />
        </Style>
        <Style x:Key="AxisMappingButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#33485F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#82B5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E1E6EC" />
                                <Setter Property="Foreground" Value="#9AA4B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AxisMappingPrimaryButton" TargetType="Button" BasedOn="{StaticResource AxisMappingButton}">
            <Setter Property="Background" Value="#2375D1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2375D1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AxisMappingOutlineButton" TargetType="Button" BasedOn="{StaticResource AxisMappingButton}">
            <Setter Property="Foreground" Value="#176BD0" />
            <Setter Property="BorderBrush" Value="#9FC5FA" />
        </Style>
        <Style x:Key="AxisMappingCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="2,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,8,14,12" ToolTip="{Binding Text, ElementName=ConfigurationFileText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,9" Margin="0,0,0,10"
                Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource 控制卡厂商}" VerticalAlignment="Center" Margin="0,0,7,0"
                               FontSize="12" Foreground="#40536A" />
                    <ComboBox x:Name="CardVendorComboBox" Width="120" Style="{StaticResource AxisMappingComboBox}"
                              SelectionChanged="CardVendorComboBox_SelectionChanged">
                        <ComboBoxItem Tag="正运动" Content="正运动" />
                        <ComboBoxItem Tag="雷赛" Content="雷赛" />
                        <ComboBoxItem Tag="凌华" Content="凌华" />
                        <ComboBoxItem Tag="其他" Content="{DynamicResource 其他厂商}" />
                    </ComboBox>
                    <Border Width="1" Height="24" Margin="10,0,0,0" Background="#D7E0EA" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource 控制卡类型}" VerticalAlignment="Center" Margin="0,0,7,0"
                               FontSize="12" Foreground="#40536A" />
                    <ComboBox x:Name="CardTypeComboBox" Width="102" Style="{StaticResource AxisMappingComboBox}"
                              SelectionChanged="CardTypeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="总线型" Content="{DynamicResource 总线型}" />
                        <ComboBoxItem Tag="脉冲型" Content="{DynamicResource 脉冲型}" />
                    </ComboBox>
                    <Border Width="1" Height="24" Margin="10,0,0,0" Background="#D7E0EA" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource 控制卡轴数量}" VerticalAlignment="Center" Margin="0,0,7,0"
                               FontSize="12" Foreground="#40536A" />
                    <ComboBox x:Name="AxisCountComboBox" Width="72" Style="{StaticResource AxisMappingComboBox}"
                              SelectionChanged="AxisCountComboBox_SelectionChanged">
                        <ComboBoxItem Tag="8" Content="8" />
                        <ComboBoxItem Tag="16" Content="16" />
                        <ComboBoxItem Tag="32" Content="32" />
                        <ComboBoxItem Tag="64" Content="64" />
                    </ComboBox>
                    <Border Width="1" Height="24" Margin="10,0,0,0" Background="#D7E0EA" />
                </StackPanel>
                <TextBlock x:Name="ConfiguredAxisCountText" VerticalAlignment="Center" Margin="0,0,14,0"
                           FontSize="12" FontWeight="SemiBold" Foreground="#26384D"
                           Text="{DynamicResource 已配置轴数量默认}"
                           ToolTip="{DynamicResource 卡适配器由Host指定}" />
                <Border x:Name="CardConnectionStatusBadge" VerticalAlignment="Center" Padding="9,6"
                        Margin="0,0,10,0" Background="#EFF4F9" CornerRadius="12"
                        ToolTip="{Binding Text, ElementName=CardConnectionStatusText}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Margin="0,0,7,0" Fill="#8797A8" />
                        <TextBlock x:Name="CardConnectionStatusText" VerticalAlignment="Center"
                                   MaxWidth="205" TextTrimming="CharacterEllipsis"
                                   FontSize="11" Foreground="#596B7D"
                                   Text="{DynamicResource 控制卡未连接首次提示}" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConnectCardButton" Content="{DynamicResource 连接运动控制卡}"
                            Style="{StaticResource AxisMappingOutlineButton}" MinWidth="118" Height="36"
                            Click="ConnectCardButton_Click" Margin="0,0,7,0" />
                    <Button x:Name="DisconnectCardButton" Content="{DynamicResource 断开运动控制卡}"
                            Style="{StaticResource AxisMappingButton}" MinWidth="86" Height="36"
                            Click="DisconnectCardButton_Click" IsEnabled="False" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E0E8"
                    BorderThickness="1" CornerRadius="6">
                <DataGrid x:Name="AxisMappingGrid" ItemsSource="{Binding VisibleAxes}"
                          SelectionChanged="AxisMappingGrid_SelectionChanged"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E6EBF1" VerticalGridLinesBrush="#E6EBF1"
                          RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                          RowHeight="32" FontSize="12" BorderThickness="0" Background="White">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="33" />
                            <Setter Property="Background" Value="#EEF3F8" />
                            <Setter Property="Foreground" Value="#34465A" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="5,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="BorderBrush" Value="#DCE4ED" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="#293B50" />
                            <Setter Property="BorderBrush" Value="#E6EBF1" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                    <Setter Property="Background" Value="#F5F7FA" />
                                    <Setter Property="Foreground" Value="#8793A1" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F6FD" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DDEBFC" />
                                    <Setter Property="Foreground" Value="#213F62" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="5,3" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DDEBFC" />
                                    <Setter Property="Foreground" Value="#213F62" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource 物理轴号}"
                                            Binding="{Binding AxisNumber, StringFormat='Axis{0}'}" Width="62"
                                            ElementStyle="{StaticResource AxisMappingCellText}" />
                        <DataGridTextColumn Header="{DynamicResource 设备轴名称}" Binding="{Binding Name, TargetNullValue='-'}" Width="1.15*"
                                            ElementStyle="{StaticResource AxisMappingCellText}" />
                        <DataGridTextColumn Header="{DynamicResource 轴类型}" Binding="{Binding AxisType, TargetNullValue='-'}" Width="62"
                                            ElementStyle="{StaticResource AxisMappingCellText}" />
                        <DataGridTextColumn Header="{DynamicResource 工程单位}" Binding="{Binding EngineeringUnit, TargetNullValue='-'}" Width="62"
                                            ElementStyle="{StaticResource AxisMappingCellText}" />
                        <DataGridTextColumn Header="{DynamicResource 单位换算}" Binding="{Binding UnitsPerEngineeringUnit, TargetNullValue='-', StringFormat={}{0:0.###}}" Width="84"
                                            ElementStyle="{StaticResource AxisMappingCellText}" />
                        <DataGridTextColumn Header="{DynamicResource 软限位下限}" Binding="{Binding MinimumPosition, TargetNullValue='-', StringFormat={}{0:0.000}}" Width="86"
                                            ElementStyle="{StaticResource AxisMappingCellText}" />
                        <DataGridTextColumn Header="{DynamicResource 软限位上限}" Binding="{Binding MaximumPosition, TargetNullValue='-', StringFormat={}{0:0.000}}" Width="86"
                                            ElementStyle="{StaticResource AxisMappingCellText}" />
                        <DataGridTemplateColumn Header="{DynamicResource 配置状态}" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="ConfigurationBadge" HorizontalAlignment="Center"
                                            Padding="7,2" Background="#E5EAF0" CornerRadius="9">
                                        <TextBlock x:Name="ConfigurationBadgeText" Text="{DynamicResource 未配置}"
                                                   VerticalAlignment="Center" FontSize="11" Foreground="#68788A" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                            <Setter TargetName="ConfigurationBadge" Property="Background" Value="#E4F6E9" />
                                            <Setter TargetName="ConfigurationBadgeText" Property="Text" Value="{DynamicResource 已配置}" />
                                            <Setter TargetName="ConfigurationBadgeText" Property="Foreground" Value="#168447" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Padding="12" Background="White"
                    BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,5">
                        <TextBlock Text="{DynamicResource 轴参数配置}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#24364B" />
                        <TextBlock x:Name="SelectedAxisText" Margin="10,1,0,0"
                                   VerticalAlignment="Center" Foreground="#2475D0" FontSize="12" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="AxisDetailsGrid" Margin="0,2,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" /><RowDefinition Height="34" />
                                <RowDefinition Height="34" /><RowDefinition Height="34" />
                                <RowDefinition Height="34" /><RowDefinition Height="34" />
                                <RowDefinition Height="34" /><RowDefinition Height="34" />
                                <RowDefinition Height="34" /><RowDefinition Height="42" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource 物理轴号}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PhysicalAxisTextBox" IsReadOnly="True"
                                     Style="{StaticResource AxisMappingTextBox}" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource 设备轴名称}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAxis.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AxisMappingTextBox}" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource 轴类型}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AxisTypeComboBox" Style="{StaticResource AxisMappingComboBox}"
                                      SelectionChanged="AxisTypeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="直线轴" Content="{DynamicResource 直线轴}" />
                                <ComboBoxItem Tag="旋转轴" Content="{DynamicResource 旋转轴}" />
                            </ComboBox>
                            <TextBlock Grid.Row="3" Text="{DynamicResource 工程单位}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="EngineeringUnitComboBox"
                                      Style="{StaticResource AxisMappingComboBox}" SelectionChanged="EngineeringUnitComboBox_SelectionChanged">
                                <ComboBoxItem Tag="mm" Content="mm" />
                                <ComboBoxItem Tag="deg" Content="deg" />
                            </ComboBox>
                            <TextBlock Grid.Row="4" Text="{DynamicResource 单位换算}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAxis.UnitsPerEngineeringUnit, StringFormat={}{0:0.###}}"
                                     Style="{StaticResource AxisMappingTextBox}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{DynamicResource 脉冲每工程单位}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#718096" />
                            <TextBlock Grid.Row="5" Text="{DynamicResource 软限位下限}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedAxis.MinimumPosition, StringFormat={}{0:0.000}}"
                                     Style="{StaticResource AxisMappingTextBox}" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SelectedAxis.EngineeringUnit}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#718096" />
                            <TextBlock Grid.Row="6" Text="{DynamicResource 软限位上限}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedAxis.MaximumPosition, StringFormat={}{0:0.000}}"
                                     Style="{StaticResource AxisMappingTextBox}" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding SelectedAxis.EngineeringUnit}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#718096" />
                            <TextBlock Grid.Row="7" Text="{DynamicResource 手动调试速度}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedAxis.ManualSpeed, StringFormat={}{0:0.000}}"
                                     Style="{StaticResource AxisMappingTextBox}" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding SelectedAxis.EngineeringUnit, StringFormat={}{0}/s}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#718096" />
                            <TextBlock Grid.Row="8" Text="{DynamicResource 回零模式}" Style="{StaticResource AxisMappingFieldLabel}" />
                            <ComboBox Grid.Row="8" Grid.Column="1" x:Name="HomeModeComboBox"
                                      Style="{StaticResource AxisMappingComboBox}" SelectionChanged="HomeModeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="1" Content="1" />
                                <ComboBoxItem Tag="2" Content="2" />
                                <ComboBoxItem Tag="3" Content="3" />
                                <ComboBoxItem Tag="4" Content="4" />
                                <ComboBoxItem Tag="5" Content="5" />
                                <ComboBoxItem Tag="6" Content="6" />
                                <ComboBoxItem Tag="8" Content="8" />
                                <ComboBoxItem Tag="9" Content="9" />
                                <ComboBoxItem Tag="11" Content="11" />
                                <ComboBoxItem Tag="12" Content="12" />
                                <ComboBoxItem Tag="13" Content="13" />
                                <ComboBoxItem Tag="14" Content="14" />
                                <ComboBoxItem Tag="15" Content="15" />
                                <ComboBoxItem Tag="16" Content="16" />
                                <ComboBoxItem Tag="18" Content="18" />
                                <ComboBoxItem Tag="19" Content="19" />
                            </ComboBox>
                            <Border Grid.Row="9" Grid.ColumnSpan="3" Padding="8,5" Margin="0,3"
                                    Background="#F1F7FF" BorderBrush="#D5E6FC" BorderThickness="1" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ⓘ" FontSize="15" Foreground="#2475D0" Margin="0,0,7,0"
                                               VerticalAlignment="Top" />
                                    <TextBlock x:Name="HomeModeHintTextBlock" Text="{DynamicResource 回零模式手册提示}"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#526A86" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Expander Grid.Row="10" Grid.ColumnSpan="3" Header="{DynamicResource 更多轴参数}"
                                      IsExpanded="False" Margin="0,3,0,0" FontSize="12" Foreground="#42556C">
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" /><RowDefinition Height="34" />
                                        <RowDefinition Height="34" /><RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{DynamicResource 回零搜索速度}" Style="{StaticResource AxisMappingFieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAxis.HomeSearchSpeed, StringFormat={}{0:0.000}}"
                                             Style="{StaticResource AxisMappingTextBox}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedAxis.EngineeringUnit, StringFormat={}{0}/s}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#718096" />
                                    <TextBlock Grid.Row="1" Text="{DynamicResource 回零爬行速度}" Style="{StaticResource AxisMappingFieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAxis.HomeCreepSpeed, StringFormat={}{0:0.000}}"
                                             Style="{StaticResource AxisMappingTextBox}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedAxis.EngineeringUnit, StringFormat={}{0}/s}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#718096" />
                                    <TextBlock Grid.Row="2" Text="{DynamicResource 回零加速度}" Style="{StaticResource AxisMappingFieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAxis.HomeAcceleration, StringFormat={}{0:0.000}}"
                                             Style="{StaticResource AxisMappingTextBox}" />
                                    <TextBlock Grid.Row="3" Text="{DynamicResource 回零减速度}" Style="{StaticResource AxisMappingFieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAxis.HomeDeceleration, StringFormat={}{0:0.000}}"
                                             Style="{StaticResource AxisMappingTextBox}" />
                                </Grid>
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Border Padding="8,5" Background="#F6F8FB" BorderBrush="#E4EAF1" BorderThickness="1"
                                CornerRadius="4" ToolTip="{Binding Text, ElementName=CardReadbackText}">
                            <TextBlock x:Name="CardReadbackText" Text="{DynamicResource 控制器参数未读取}"
                                       FontSize="10" Foreground="#5C6E82" TextWrapping="Wrap" MaxHeight="34"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock x:Name="ConfigurationStatusText" Text="{DynamicResource 轴映射尚未保存}"
                                   Margin="1,5,1,5" FontSize="11" Foreground="#586B80"
                                   TextTrimming="CharacterEllipsis" MaxHeight="18" />
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ClearAxisMappingButton" Grid.Column="0" Content="{DynamicResource 清除当前轴映射}"
                                    Click="ClearAxisMappingButton_Click" Style="{StaticResource AxisMappingButton}"
                                    Height="32" Padding="8,4" FontSize="11" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ReadAxisParametersButton" Content="{DynamicResource 读取控制卡参数}"
                                        Click="ReadAxisParametersButton_Click" Style="{StaticResource AxisMappingButton}"
                                        Height="32" Padding="8,4" FontSize="11" Margin="6,0,0,0" />
                                <Button x:Name="WriteAxisParametersButton" Content="{DynamicResource 写入控制卡}"
                                        Click="WriteAxisParametersButton_Click" Style="{StaticResource AxisMappingOutlineButton}"
                                        Height="32" Padding="8,4" FontSize="11" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CheckMappingButton" Content="{DynamicResource 检查映射}"
                                    Click="CheckMappingButton_Click" Style="{StaticResource AxisMappingButton}"
                                    Width="84" Height="36" Padding="6,4" Margin="0,0,7,0" />
                            <Button x:Name="SaveConfigurationButton" Content="{DynamicResource 保存配置}"
                                    Click="SaveConfigurationButton_Click" Style="{StaticResource AxisMappingPrimaryButton}"
                                    Width="96" Height="36" Padding="6,4" Margin="0,0,7,0" />
                            <Button Content="{DynamicResource 取消修改}" Click="CancelChangesButton_Click"
                                    Style="{StaticResource AxisMappingButton}" Width="84" Height="36" Padding="6,4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="ConfigurationFileText" Visibility="Collapsed" />
    </Grid>
</UserControl>
