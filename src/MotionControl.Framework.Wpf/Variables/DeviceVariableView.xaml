<UserControl x:Class="MotionControl.Framework.Wpf.Variables.DeviceVariableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="VariablePageButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#33485F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#82B5F5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E1E6EC" />
                                <Setter Property="Foreground" Value="#9AA4B1" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F3F6" />
                    <Setter Property="BorderBrush" Value="#E1E6EC" />
                    <Setter Property="Foreground" Value="#9AA4B1" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VariablePagePrimaryButton" TargetType="Button" BasedOn="{StaticResource VariablePageButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2375D1" />
            <Setter Property="BorderBrush" Value="#2375D1" />
        </Style>
        <Style x:Key="VariablePageWarningButton" TargetType="Button" BasedOn="{StaticResource VariablePageButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#805500" />
            <Setter Property="Background" Value="#FFF7E8" />
            <Setter Property="BorderBrush" Value="#E8C77E" />
        </Style>
        <Style x:Key="VariablePageInput" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F5F9" />
                                <Setter Property="Foreground" Value="#8A96A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="Foreground" Value="#40536A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#D9E0E8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FD" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E7F1FE" />
                    <Setter Property="Foreground" Value="#1F3C5C" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="BorderBrush" Value="#E1E7EF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E7F1FE" />
                    <Setter Property="Foreground" Value="#1F3C5C" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VariableCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="VariableDescriptionCellText"
               TargetType="TextBlock"
               BasedOn="{StaticResource VariableCellText}">
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12"
                Background="#F7F9FC"
                BorderBrush="#D8E2EE"
                BorderThickness="1"
                CornerRadius="6">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddVariableButton"
                            Content="{DynamicResource 变量新增}"
                            Style="{StaticResource VariablePagePrimaryButton}"
                            Click="AddVariableButton_Click" />
                    <Button x:Name="EditVariableButton"
                            Content="{DynamicResource 变量编辑定义}"
                            Style="{StaticResource VariablePageButton}"
                            Click="EditVariableButton_Click" />
                    <Button x:Name="DeleteVariableButton"
                            Content="{DynamicResource 变量删除}"
                            Style="{StaticResource VariablePageButton}"
                            Click="DeleteVariableButton_Click" />
                </StackPanel>

                <Border Margin="0,4,0,0"
                        Padding="10,6"
                        Background="#FFF9EF"
                        BorderBrush="#F0DEB7"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#40536A"
                                   Text="{DynamicResource 变量写入值}" />
                        <TextBox x:Name="ManualValueTextBox"
                                 Width="190"
                                 Style="{StaticResource VariablePageInput}"
                                 ToolTip="{DynamicResource 变量写入值提示}" />
                        <Button x:Name="WriteValueButton"
                                Margin="8,0,0,0"
                                Content="{DynamicResource 变量写入当前值}"
                                Style="{StaticResource VariablePageWarningButton}"
                                Click="WriteValueButton_Click" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,8"
                Padding="8,6"
                Background="#EAF2FB"
                BorderBrush="#D5E4F5"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#40536A"
                           FontWeight="SemiBold"
                           Text="{DynamicResource 变量页面就绪}" />
                <TextBlock x:Name="SelectedVariableContextText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#40536A"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <ScrollViewer x:Name="DefinitionApplyWarningScroll" Visibility="Collapsed" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource 配置变更提示关闭}" Click="DismissDefinitionWarning_Click" />
                            <TextBlock x:Name="DefinitionApplyWarningText" TextWrapping="Wrap" Foreground="#B54747" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ChangeHistoryWarningScroll" Visibility="Collapsed" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource 配置变更提示关闭}" Click="DismissHistoryWarning_Click" />
                            <TextBlock x:Name="ChangeHistoryWarningText" TextWrapping="Wrap" Foreground="#A35D08" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                    </ScrollViewer>
                    <DockPanel Margin="0,5,0,0"><Button x:Name="ClearVariableSearchButton" DockPanel.Dock="Right" Content="{DynamicResource 变量清除筛选}" Click="ClearVariableSearch_Click" /><TextBlock x:Name="VariableSearchCountText" DockPanel.Dock="Right" Margin="8,0" /><TextBox x:Name="VariableSearchBox" ToolTip="{DynamicResource 变量搜索提示}" TextChanged="VariableSearch_TextChanged" /></DockPanel>
                    <TextBlock Text="{DynamicResource 变量筛选保留选择}" Foreground="#596B7D" />
                    <TextBlock x:Name="SelectedDefinitionSummaryText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="58" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Margin="0,6,0,0" Foreground="#40536A" />
                    <TextBlock Margin="0,5,0,0" Foreground="#596B7D"
                               TextWrapping="Wrap" Text="{DynamicResource 变量运行值说明}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D9E0E8"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="VariablesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeRows="False"
                      IsReadOnly="True"


                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FontSize="13"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E1E7EF"
                      VerticalGridLinesBrush="#E1E7EF"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F9FBFD"
                      CanUserResizeColumns="True"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      SelectionChanged="VariablesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" MinWidth="120"
                                        Header="{DynamicResource 变量名称}"
                                        Binding="{Binding NameDisplay}"
                                        ElementStyle="{StaticResource VariableCellText}" />
                    <DataGridTextColumn Width="*" MinWidth="80"
                                        Header="{DynamicResource 变量类型}"
                                        Binding="{Binding DataTypeDisplay}"
                                        ElementStyle="{StaticResource VariableCellText}" />
                    <DataGridTextColumn Width="2*" MinWidth="120"
                                        Header="{DynamicResource 当前值}"
                                        Binding="{Binding CurrentValueDisplay}"
                                        ElementStyle="{StaticResource VariableCellText}" />
                    <DataGridTextColumn Width="1.4*" MinWidth="140"
                                        Header="{DynamicResource 最后更新时间}"
                                        Binding="{Binding LastUpdatedDisplay}"
                                        ElementStyle="{StaticResource VariableCellText}" />
                    <DataGridTextColumn Width="90" Header="{DynamicResource 变量工程单位}"
                                        Binding="{Binding EngineeringUnitDisplay}"
                                        ElementStyle="{StaticResource VariableCellText}" />
                    <DataGridTextColumn Width="2*" MinWidth="120"
                                        Header="{DynamicResource 变量说明}"
                                        Binding="{Binding Description}"
                                        ElementStyle="{StaticResource VariableDescriptionCellText}" />
                    <DataGridCheckBoxColumn Header="{DynamicResource 变量人工可写}" Binding="{Binding AllowOperatorWrite, Mode=OneWay}" IsReadOnly="True" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
