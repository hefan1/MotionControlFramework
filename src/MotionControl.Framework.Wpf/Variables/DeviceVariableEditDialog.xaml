<Window x:Class="MotionControl.Framework.Wpf.Variables.DeviceVariableEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource 变量定义窗口标题}"
        Width="520"
        Height="470"
        MinWidth="480"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogInput" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#33485F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2375D1" />
            <Setter Property="BorderBrush" Value="#2375D1" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量名称}" Foreground="#40536A" />
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogInput}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量类型}" Foreground="#40536A" />
        <ComboBox x:Name="DataTypeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Height="32" VerticalContentAlignment="Center">
            <ComboBoxItem Tag="Boolean" Content="{DynamicResource 变量类型布尔}" />
            <ComboBoxItem Tag="Integer" Content="{DynamicResource 变量类型整数}" />
            <ComboBoxItem Tag="Number" Content="{DynamicResource 变量类型小数}" />
            <ComboBoxItem Tag="String" Content="{DynamicResource 变量类型字符串}" />
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量初始值}" Foreground="#40536A" />
        <TextBox x:Name="InitialValueTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogInput}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量说明}" Foreground="#40536A" />
        <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogInput}" />

        <CheckBox x:Name="AllowOperatorWriteCheckBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  VerticalAlignment="Center"
                  Content="{DynamicResource 变量允许现场写入}" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="6"
                   Grid.ColumnSpan="2"
                   Margin="0,8"
                   Foreground="#B42318"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource 取消}"
                    IsCancel="True"
                    Style="{StaticResource DialogButton}" />
            <Button Content="{DynamicResource 保存}"
                    IsDefault="True"
                    Style="{StaticResource DialogPrimaryButton}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
