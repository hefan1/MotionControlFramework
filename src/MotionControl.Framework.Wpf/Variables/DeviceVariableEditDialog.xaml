<Window x:Class="MotionControl.Framework.Wpf.Variables.DeviceVariableEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource 变量定义窗口标题}"
        Width="560"
        Height="525"
        MinWidth="540"
        MinHeight="505"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogInput" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#26384D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD5E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#33485F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D5E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#82B5F5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2475D0" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E1E6EC" />
                                <Setter Property="Foreground" Value="#9AA4B1" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2375D1" />
            <Setter Property="BorderBrush" Value="#2375D1" />
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Padding="20"
            Background="White"
            BorderBrush="#D9E0E8"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Margin="0,0,0,14"
                       FontSize="12"
                       Foreground="#596B7D"
                       Text="{DynamicResource 变量定义窗口说明}"
                       TextWrapping="Wrap" />
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16" Height="1" Background="#E5EAF0" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量名称}" Foreground="#40536A" />
            <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogInput}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量类型}" Foreground="#40536A" />
            <ComboBox x:Name="DataTypeComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogComboBox}">
                <ComboBoxItem Tag="Boolean" Content="{DynamicResource 变量类型布尔}" />
                <ComboBoxItem Tag="Integer" Content="{DynamicResource 变量类型整数}" />
                <ComboBoxItem Tag="Number" Content="{DynamicResource 变量类型小数}" />
                <ComboBoxItem Tag="String" Content="{DynamicResource 变量类型字符串}" />
                <ComboBoxItem Tag="Byte" Content="{DynamicResource 变量类型字节}" />
                <ComboBoxItem Tag="Character" Content="{DynamicResource 变量类型字符}" />
                <ComboBoxItem Tag="DateTime" Content="{DynamicResource 变量类型日期时间}" />
            </ComboBox>

            <TextBlock Grid.Row="4"
                       Grid.Column="1"
                       Margin="0,-7,0,12"
                       FontSize="11"
                       Foreground="#596B7D"
                       Text="{DynamicResource 变量类型说明}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量初始值}" Foreground="#40536A" />
            <TextBox x:Name="InitialValueTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogInput}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource 变量说明}" Foreground="#40536A" />
            <TextBox x:Name="DescriptionTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogInput}" />

            <CheckBox x:Name="AllowOperatorWriteCheckBox"
                      Grid.Row="7"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      VerticalAlignment="Center"
                      Content="{DynamicResource 变量允许现场写入}" />

            <TextBlock x:Name="ErrorText"
                       Grid.Row="8"
                       Grid.ColumnSpan="2"
                       Margin="0,8"
                       Foreground="#B42318"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource 取消}"
                        IsCancel="True"
                        Style="{StaticResource DialogButton}" />
                <Button Content="{DynamicResource 保存}"
                        IsDefault="True"
                        Style="{StaticResource DialogPrimaryButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
