<UserControl x:Class="MotionControl.TaskEngine.Wpf.Editing.TaskEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/TaskMonitorStyles.xaml"/><ResourceDictionary Source="../Styles/TaskEditingStyles.xaml"/>
  <ResourceDictionary Source="../Localization/Strings.Editor.zh-CN.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="14,8,14,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="IssuesRow" Height="0"/></Grid.RowDefinitions>
  <Border Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="7">
   <WrapPanel>
    <Button Content="{DynamicResource 任务编辑.返回任务配置}" Click="Back_Click"/>
    <TextBox x:Name="TaskNameBox" Width="190" Margin="7,0" ToolTip="{DynamicResource 任务编辑.任务名称}"/>
    <Button Content="{DynamicResource 任务编辑.新增步骤}" Click="Add_Click"/>
    <Button Content="{DynamicResource 任务编辑.上移}" Click="Up_Click"/><Button Content="{DynamicResource 任务编辑.下移}" Click="Down_Click"/>
    <Button Content="{DynamicResource 任务编辑.复制}" Click="Copy_Click"/><Button Content="{DynamicResource 任务编辑.删除}" Click="Delete_Click"/>
    <Button Content="{DynamicResource 任务编辑.保存草稿}" Click="Save_Click" Style="{StaticResource 编辑主要按钮}"/>
    <Button Content="{DynamicResource 任务编辑.检查任务}" Click="Check_Click"/>
    <Button Content="{DynamicResource 任务编辑.保留草稿副本}" Click="LocalCopy_Click"/>
   </WrapPanel>
  </Border>
  <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Foreground="#176BD0" Margin="2,8"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.05*" MinWidth="340"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource 内容边框}"><DockPanel Margin="9">
    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource 任务编辑.选中步骤只编辑参数，不执行动作}" Foreground="#596B7D" Margin="4,2,4,8" TextWrapping="Wrap"/>
    <TreeView x:Name="StepsTree" SelectedItemChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="0"/>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#D8E2EE"/>
   <Border Grid.Column="2" Style="{StaticResource 内容边框}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Details" Margin="13"/></ScrollViewer></Border>
  </Grid>
  <DataGrid x:Name="IssuesGrid" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="IssueSelected">
   <DataGrid.Columns><DataGridTextColumn Binding="{Binding Severity}" Width="65"/><DataGridTextColumn Binding="{Binding StepName}" Width="170"/><DataGridTextColumn Binding="{Binding Field}" Width="100"/><DataGridTextColumn Binding="{Binding Message}" Width="*"/></DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
