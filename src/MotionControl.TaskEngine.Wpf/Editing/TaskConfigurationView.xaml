<UserControl x:Class="MotionControl.TaskEngine.Wpf.Editing.TaskConfigurationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/TaskMonitorStyles.xaml"/><ResourceDictionary Source="../Styles/TaskEditingStyles.xaml"/><ResourceDictionary Source="../Localization/Strings.Editor.zh-CN.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="14,8,14,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="ConfigIssueRow" Height="100"/></Grid.RowDefinitions>
  <Border x:Name="ConfigToolbar" Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="7"><WrapPanel>
   <Button x:Name="SaveAndCheckButton" Content="{DynamicResource 任务编辑.保存并检查}" Click="SaveAndCheck_Click" Style="{StaticResource 编辑主要按钮}"/>
   <Button x:Name="BackupRestoreButton" Content="{DynamicResource 任务编辑.备份与恢复}" Click="BackupRestore_Click"/>
   <Button x:Name="ApplyButton" Content="{DynamicResource 任务编辑.更新任务文件}" Click="Apply_Click"/>
   <Button x:Name="RebaseDraftButton" Content="{DynamicResource 任务编辑.保留草稿并同步来源}" ToolTip="{DynamicResource 任务编辑.保留草稿并同步来源提示}" Click="RebaseDraft_Click" Visibility="Collapsed"/>
   <Button x:Name="ReloadRuntimeButton" Content="{DynamicResource 任务编辑.重新载入运行文件}" ToolTip="{DynamicResource 任务编辑.重新载入运行文件提示}" Click="ReloadRuntimeFiles_Click" Visibility="Collapsed"/>
   <Button x:Name="RecoverButton" Content="{DynamicResource 任务编辑.恢复上次应用}" Click="Recover_Click"/>
  </WrapPanel></Border>
  <StackPanel x:Name="ConfigurationStatus" Grid.Row="1" Margin="2,7">
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#176BD0"/>
   <Border x:Name="RuntimeContextPanel" Background="#F7F9FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,5,0,0">
    <DockPanel LastChildFill="True">
     <Button x:Name="CurrentFlowButton" DockPanel.Dock="Right" Content="{DynamicResource 任务编辑.查看当前流程状态}" Click="CurrentFlow_Click" Margin="10,0,0,0" Padding="9,4" VerticalAlignment="Center"/>
     <StackPanel>
      <TextBlock x:Name="RuntimeStateText" FontWeight="SemiBold" Foreground="#26384D"/>
      <TextBlock x:Name="RuntimeReadinessText" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#845B0A" Visibility="Collapsed"/>
      <TextBlock x:Name="RuntimeStationsText" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#40536A"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Expander x:Name="ErrorDiagnosticsExpander" Margin="0,5,0,0" Visibility="Collapsed" Header="{DynamicResource 任务编辑.查看完整诊断信息}" Background="#F7F9FC" BorderBrush="#D9E0E8" BorderThickness="1" Padding="6">
    <TextBox x:Name="ErrorDiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
   </Expander>
   <TextBlock x:Name="ApplyReasonText" TextWrapping="Wrap" Foreground="#946200"/>
  </StackPanel>
  <ContentControl x:Name="ContentHost" Grid.Row="2"><TabControl x:Name="MainTabs">
   <TabItem Header="{DynamicResource 任务编辑.工位安排}"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="1.3*" MinHeight="150"/></Grid.RowDefinitions>
    <WrapPanel><Button Content="{DynamicResource 任务编辑.新增工位}" Click="AddStation_Click"/><Button Content="{DynamicResource 任务编辑.移除工位}" Click="RemoveStation_Click"/></WrapPanel>
    <DataGrid x:Name="StationsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource 编辑表头}" SelectionChanged="StationSelected"><DataGrid.Columns>
     <DataGridCheckBoxColumn Binding="{Binding Source.Enabled}" Width="75"/><DataGridTextColumn Binding="{Binding Source.Name}" Width="*" MinWidth="110"/><DataGridTextColumn Binding="{Binding TaskName}" Width="1.5*" MinWidth="130"/><DataGridTextColumn Binding="{Binding Mode}" Width="125"/>
     <DataGridTextColumn Binding="{Binding AppliedVersion}" Width="105"/>
     <DataGridTemplateColumn Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{DynamicResource 任务编辑.编辑任务}" Tag="{Binding Source}" Click="EditStationTask_Click" Padding="5,2" MinHeight="24"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid>
    <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource 内容边框}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="StationDetails" Margin="10"/></ScrollViewer></Border>
     <Border Grid.Column="2" Style="{StaticResource 内容边框}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MachineDetails" Margin="10"/></ScrollViewer></Border>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="{DynamicResource 任务编辑.任务库}"><DockPanel Margin="8"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
    <Button Content="{DynamicResource 任务编辑.新增任务}" Click="NewTask_Click"/><Button Content="{DynamicResource 任务编辑.复制任务}" Click="CopyTask_Click"/><Button Content="{DynamicResource 任务编辑.导入任务}" Click="ImportTask_Click"/><Button Content="{DynamicResource 任务编辑.编辑任务}" Click="EditTask_Click"/><Button Content="{DynamicResource 任务编辑.查看引用}" Click="References_Click"/><Button Content="{DynamicResource 任务编辑.删除任务}" Click="RemoveTask_Click"/>
   </WrapPanel><DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource 编辑表头}" IsReadOnly="True" MouseDoubleClick="EditTask_Click"><DataGrid.Columns>
    <DataGridTextColumn Binding="{Binding Definition.Name}" Width="1.3*" MinWidth="130"/><DataGridTextColumn Binding="{Binding Definition.TaskId}" Width="*" MinWidth="110"/><DataGridTextColumn Binding="{Binding AppliedVersion}" Width="105"/><DataGridTextColumn Binding="{Binding DraftState}" Width="140"/><DataGridTextColumn Binding="{Binding FileName}" Width="1.5*" MinWidth="125"/>
   </DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl></ContentControl>
  <DataGrid x:Name="IssuesGrid" Grid.Row="3" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="IssueOpen"><DataGrid.Columns>
   <DataGridTextColumn Binding="{Binding Severity}" Width="65"/><DataGridTextColumn Binding="{Binding TaskName}" Width="160"/><DataGridTextColumn Binding="{Binding StepName}" Width="180"/><DataGridTextColumn Binding="{Binding Field}" Width="90"/><DataGridTextColumn Binding="{Binding Message}" Width="*"/>
  </DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
