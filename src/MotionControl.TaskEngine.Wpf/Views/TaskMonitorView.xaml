<UserControl x:Class="MotionControl.TaskEngine.Wpf.Views.TaskMonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:rows="clr-namespace:MotionControl.TaskEngine.Wpf.Monitoring" Background="#F3F6FA">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="../Styles/TaskMonitorStyles.xaml"/>
   <ResourceDictionary Source="../Localization/Strings.zh-CN.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <HierarchicalDataTemplate DataType="{x:Type rows:TaskStepRow}" ItemsSource="{Binding Children}">
   <Grid Margin="0,5" ToolTip="{Binding Detail}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="74"/><ColumnDefinition Width="1.1*" MinWidth="110"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Number}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="3" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </Grid>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeViewItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
   <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
   <Setter Property="Padding" Value="2"/><Setter Property="BorderBrush" Value="#E1E7EF"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
 </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="14,8,14,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="120"/><RowDefinition Height="8"/><RowDefinition Height="5*" MinHeight="230"/></Grid.RowDefinitions>
  <Border Background="#EAF2FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
   <DockPanel><TextBlock x:Name="RefreshStatus" DockPanel.Dock="Right" Foreground="#596B7D" Margin="15,0,0,0"/>
    <TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="#40536A"/></DockPanel>
  </Border>
  <DataGrid x:Name="StationsGrid" Grid.Row="1" SelectionChanged="Station_Selected" IsReadOnly="True" AutoGenerateColumns="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="{DynamicResource 任务监控.任务名称}" Binding="{Binding Name}" Width="1.1*"/>
    <DataGridTextColumn Header="{DynamicResource 任务监控.方式}" Binding="{Binding Mode}" Width="80"/>
    <DataGridTextColumn Header="{DynamicResource 任务监控.状态}" Binding="{Binding State}" Width="88">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Color}"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="{DynamicResource 任务监控.当前动作}" Binding="{Binding Action}" Width="1.6*"/>
    <DataGridTextColumn Header="{DynamicResource 任务监控.等待或异常说明}" Binding="{Binding Detail}" Width="2*"/>
    <DataGridTextColumn Header="{DynamicResource 任务监控.完成次数}" Binding="{Binding Cycles}" Width="85"/>
   </DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="#D8E2EE"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="400"/><ColumnDefinition Width="8"/><ColumnDefinition Width="390" MinWidth="320"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource 内容边框}">
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8">
      <Button x:Name="LocateCurrentCauseButton" DockPanel.Dock="Right" Content="{DynamicResource 任务监控.定位当前原因}"
              ToolTip="{DynamicResource 任务监控.定位当前原因说明}" Click="LocateCurrentCause_Click"/>
      <CheckBox x:Name="FollowBox" DockPanel.Dock="Right" Content="{DynamicResource 任务监控.跟随执行}" IsChecked="True" Checked="FollowBox_Changed" Unchecked="FollowBox_Changed" VerticalAlignment="Center" Margin="10,0"/>
      <TextBlock x:Name="StepsTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#D9E0E8" BorderThickness="1" Padding="20,6,4,6">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{DynamicResource 任务监控.步序}"/><TextBlock Grid.Column="1" Text="{DynamicResource 任务监控.动作说明}"/><TextBlock Grid.Column="2" Text="{DynamicResource 任务监控.状态}"/><TextBlock Grid.Column="3" Text="{DynamicResource 任务监控.执行说明}"/>
      </Grid>
     </Border>
     <TreeView x:Name="StepsTree" Grid.Row="2" BorderBrush="#D9E0E8" BorderThickness="1,0,1,1" SelectedItemChanged="Step_Selected" PreviewMouseDown="StepsTree_PreviewMouseDown" PreviewKeyDown="StepsTree_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D8E2EE"/>
   <Border Grid.Column="2" Style="{StaticResource 内容边框}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="14">
      <TextBlock Text="{DynamicResource 任务监控.步骤详情}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock x:Name="DetailKind" Foreground="#596B7D" Margin="0,0,0,8"/>
      <Border Background="#EEF5FF" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="4" Padding="9">
       <TextBlock x:Name="DetailSummary" TextWrapping="Wrap" Foreground="#176BD0"/>
      </Border>
      <TextBlock x:Name="RecordNote" Foreground="#596B7D" TextWrapping="Wrap" Margin="0,8"/>
      <DataGrid x:Name="ObservationTable" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="50" MaxHeight="230">
       <DataGrid.Columns><DataGridTextColumn x:Name="ItemColumn" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn x:Name="ExpectedColumn" Binding="{Binding Expected}" Width="*"/>
        <DataGridTextColumn x:Name="ActualColumn" Binding="{Binding Actual}" Width="*"/>
        <DataGridTextColumn Header="{DynamicResource 任务监控.结果}" Binding="{Binding Result}" Width="75"/>
       </DataGrid.Columns>
      </DataGrid>
      <ItemsControl x:Name="FlowDetails" Margin="0,8"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,0,0,7"><TextBlock Text="{Binding Name}" Foreground="#596B7D"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap"/></StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander Header="{DynamicResource 任务监控.步骤参数}" Margin="0,8" Padding="4" BorderBrush="#D8E2EE" BorderThickness="1">
       <ItemsControl x:Name="ParametersList"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Name}" Foreground="#596B7D"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Expander>
      <TextBlock Text="{DynamicResource 任务监控.关联配置}" Foreground="#596B7D" Margin="0,8,0,3"/>
      <WrapPanel x:Name="ReferencesPanel"/>
      <TextBlock x:Name="DetailNotice" TextWrapping="Wrap" Foreground="#596B7D" Margin="0,8"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
