<UserControl x:Class="MotionControl.TaskEngine.Wpf.Views.TaskMonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:rows="clr-namespace:MotionControl.TaskEngine.Wpf.Monitoring" xmlns:sys="clr-namespace:System;assembly=mscorlib" Background="#F3F6FA">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="../Styles/TaskMonitorStyles.xaml"/>
   <ResourceDictionary Source="../Localization/Strings.zh-CN.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <HierarchicalDataTemplate DataType="{x:Type rows:TaskStepRow}" ItemsSource="{Binding Children}">
   <Grid Margin="0,5" ToolTip="{Binding EngineeringDetail}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Number}" VerticalAlignment="Center"/>
    <TextBlock x:Name="StepNameText" Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" Margin="0,0,10,0" ClipToBounds="True" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <TextBlock x:Name="StepStateText" Grid.Column="2" Text="{Binding StateText}" ToolTip="{Binding Detail}" Foreground="{Binding StateColor}" ClipToBounds="True" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </Grid>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeViewItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
   <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
   <Setter Property="Padding" Value="2"/><Setter Property="BorderBrush" Value="#E1E7EF"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ToggleButton x:Name="Expand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Width="18" Height="30" VerticalAlignment="Top">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock x:Name="Arrow" Text="›" FontSize="18" Foreground="#596B7D" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Border>
       <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="RowBorder" Grid.Column="1" Background="Transparent" BorderThickness="2,0,0,1" BorderBrush="#E1E7EF" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/></Border>
     <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,0,0"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expand" Property="Visibility" Value="Hidden"/></Trigger>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#E6F1FF"/><Setter TargetName="RowBorder" Property="BorderBrush" Value="#2375D1"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="#2375D1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="14,8,14,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#EAF2FC" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
   <DockPanel><TextBlock x:Name="RefreshStatus" DockPanel.Dock="Right" Foreground="#596B7D" Margin="15,0,0,0"/>
    <ScrollViewer x:Name="WarningScroll" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="#40536A"/>
    </ScrollViewer></DockPanel>
  </Border>
  <ScrollViewer x:Name="TaskWorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="TaskRunWorkspace" SizeChanged="TaskRunWorkspace_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="TaskStationColumn" Width="1.1*"/><ColumnDefinition x:Name="TaskFirstGapColumn" Width="10"/><ColumnDefinition x:Name="TaskStepsColumn" Width="2.4*"/><ColumnDefinition x:Name="TaskSecondGapColumn" Width="10"/><ColumnDefinition x:Name="TaskDetailsColumn" Width="1.8*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="TaskStationRow" Height="*"/><RowDefinition x:Name="TaskFirstGapRow" Height="0"/><RowDefinition x:Name="TaskStepsRow" Height="0"/><RowDefinition x:Name="TaskSecondGapRow" Height="0"/><RowDefinition x:Name="TaskDetailsRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="TaskStationListCard" Style="{StaticResource 内容边框}">
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource 任务监控.工位列表}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid Grid.Row="1">
      <DataGrid x:Name="StationsGrid" SelectionChanged="Station_Selected" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="54" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
       <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <StackPanel Margin="4,3" ToolTip="{Binding EngineeringDetail}">
         <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding State}" Foreground="{Binding Color}"/><TextBlock Text=" · " Foreground="#596B7D"/><TextBlock Text="{Binding Mode}" Foreground="#596B7D"/></StackPanel>
         <TextBlock x:Name="StationActionText" Text="{Binding Action}" ToolTip="{Binding Action}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
           <DataTrigger Binding="{Binding Action}" Value="—"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
           <DataTrigger Binding="{Binding Action}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
           <DataTrigger Binding="{Binding Action}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <TextBlock x:Name="StationDetailText" Text="{Binding Detail}" ToolTip="{Binding Detail}" Foreground="#596B7D" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
           <DataTrigger Binding="{Binding Detail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
           <DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
      </DataGrid>
      <ComboBox x:Name="NarrowTaskStationPicker" ItemsSource="{Binding ItemsSource, ElementName=StationsGrid}" SelectedItem="{Binding SelectedItem, ElementName=StationsGrid, Mode=TwoWay}" Visibility="Collapsed" VerticalAlignment="Top" MinHeight="34">
       <ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="2,2">
        <DockPanel><TextBlock x:Name="NarrowStationState" DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding Color}" Margin="8,0,0,0"/>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DockPanel>
        <TextBlock x:Name="NarrowStationAction" Text="{Binding Action}" ToolTip="{Binding Action}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
          <DataTrigger Binding="{Binding Action}" Value="—"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          <DataTrigger Binding="{Binding Action}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          <DataTrigger Binding="{Binding Action}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock x:Name="NarrowStationDetail" Text="{Binding Detail}" ToolTip="{Binding Detail}" Foreground="#596B7D" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
          <DataTrigger Binding="{Binding Detail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          <DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
     </Grid>
    </Grid>
   </Border>
   <Border x:Name="TaskStepsCard" Grid.Column="2" Style="{StaticResource 内容边框}">
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8">
      <Button x:Name="LocateCurrentCauseButton" DockPanel.Dock="Right" Content="{DynamicResource 任务监控.定位当前原因}"
              ToolTip="{DynamicResource 任务监控.定位当前原因说明}" Click="LocateCurrentCause_Click"/>
      <CheckBox x:Name="FollowBox" DockPanel.Dock="Right" Content="{DynamicResource 任务监控.跟随执行}" IsChecked="True" Checked="FollowBox_Changed" Unchecked="FollowBox_Changed" VerticalAlignment="Center" Margin="10,0"/>
      <TextBlock x:Name="StepsTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#D9E0E8" BorderThickness="1" Padding="20,6,4,6">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
       <TextBlock Text="{DynamicResource 任务监控.步序}"/><TextBlock Grid.Column="1" Text="{DynamicResource 任务监控.动作说明}"/><TextBlock Grid.Column="2" Text="{DynamicResource 任务监控.状态}"/>
      </Grid>
     </Border>
     <TreeView x:Name="StepsTree" Grid.Row="2" BorderBrush="#D9E0E8" BorderThickness="1,0,1,1" HorizontalContentAlignment="Stretch" SelectedItemChanged="Step_Selected" PreviewMouseDown="StepsTree_PreviewMouseDown" PreviewKeyDown="StepsTree_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Grid>
   </Border>
   <Border x:Name="TaskStepDetailsCard" Grid.Column="4" Style="{StaticResource 内容边框}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="14">
     <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource 任务监控.当前执行节点}" FontWeight="SemiBold" Margin="0,1,10,3"/>
      <ScrollViewer Grid.Column="1" MaxHeight="64" VerticalScrollBarVisibility="Auto">
       <TextBlock x:Name="ExecutingNodesText" TextWrapping="Wrap" ToolTip="{DynamicResource 任务监控.当前执行来源}"/>
      </ScrollViewer>
      <TextBlock Grid.Row="1" Text="{DynamicResource 任务监控.当前查看节点}" FontWeight="SemiBold" Margin="0,2,10,0"/>
      <TextBlock x:Name="ViewedNodeText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" ToolTip="{DynamicResource 任务监控.当前查看来源}"/>
     </Grid>
      <TextBlock Text="{DynamicResource 任务监控.步骤详情}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock x:Name="DetailKind" Foreground="#596B7D" Margin="0,0,0,8"/>
      <Border Background="#EEF5FF" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="4" Padding="9">
       <TextBlock x:Name="DetailSummary" TextWrapping="Wrap" Foreground="#176BD0"/>
      </Border>
      <TextBlock x:Name="RecordNote" Foreground="#596B7D" TextWrapping="Wrap" Margin="0,8"/>
      <TextBlock x:Name="DetailNotice" TextWrapping="Wrap" Foreground="#596B7D" Margin="0,8"/>
      <DataGrid x:Name="ObservationTable" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="50" MaxHeight="230">
       <DataGrid.Columns><DataGridTextColumn x:Name="ItemColumn" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn x:Name="ExpectedColumn" Binding="{Binding Expected}" Width="*"/>
        <DataGridTextColumn x:Name="ActualColumn" Binding="{Binding Actual}" Width="*"/>
        <DataGridTextColumn Header="{DynamicResource 任务监控.结果}" Binding="{Binding Result}" Width="75"/>
       </DataGrid.Columns>
      </DataGrid>
      <ItemsControl x:Name="FlowDetails" Margin="0,8"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,0,0,7"><TextBlock Text="{Binding Name}" Foreground="#596B7D"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap"/></StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander x:Name="GlobalProjectionDiagnosticsExpander" Header="{DynamicResource 任务监控.工程范围投影诊断详情}" Visibility="Collapsed" Margin="0,0,0,8" Padding="4" BorderBrush="#D8E2EE" BorderThickness="1">
       <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="GlobalProjectionDiagnostics"><ItemsControl.ItemTemplate><DataTemplate>
         <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="4,3"/>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
      </Expander>
      <Expander Header="{DynamicResource 任务监控.步骤参数}" Margin="0,8" Padding="4" BorderBrush="#D8E2EE" BorderThickness="1">
       <ItemsControl x:Name="ParametersList"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Name}" Foreground="#596B7D"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Expander>
      <TextBlock Text="{DynamicResource 任务监控.关联配置}" Foreground="#596B7D" Margin="0,8,0,3"/>
      <WrapPanel x:Name="ReferencesPanel"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>
