{
  "schemaVersion": 1,
  "taskId": "ClipInit",
  "name": "检查测试工位无料并初始化交接",
  "revision": 2,
  "root": {
    "kind": "Sequence",
    "id": "ClipInitRoot",
    "name": "检查测试工位无料并初始化交接",
    "timeoutMs": 900000,
    "children": [
      {
        "kind": "WaitCondition",
        "id": "checkAllStationsEmpty",
        "name": "检查四个测试工位无料",
        "timeoutMs": 3000,
        "timeoutAlarmCodes": ["FOUR_HANDSHAKE_TIMEOUT"],
        "condition": {
          "kind": "All",
          "conditions": [
            { "kind": "Compare", "comparison": "Equal", "left": { "source": "Variable", "variableName": "Clip.Scan.Occupied" }, "right": { "source": "Constant", "dataType": "Boolean", "constant": "false" } },
            { "kind": "Compare", "comparison": "Equal", "left": { "source": "Variable", "variableName": "Clip.Weld.Occupied" }, "right": { "source": "Constant", "dataType": "Boolean", "constant": "false" } },
            { "kind": "Compare", "comparison": "Equal", "left": { "source": "Variable", "variableName": "Clip.Press.Occupied" }, "right": { "source": "Constant", "dataType": "Boolean", "constant": "false" } },
            { "kind": "Compare", "comparison": "Equal", "left": { "source": "Variable", "variableName": "Clip.Inspect.Occupied" }, "right": { "source": "Constant", "dataType": "Boolean", "constant": "false" } }
          ]
        }
      },
      {
        "kind": "SetVariable",
        "id": "initClipSWReady",
        "name": "初始化Clip.SWReady",
        "timeoutMs": 30000,
        "variableName": "Clip.SW.Ready",
        "value": {
          "source": "Constant",
          "dataType": "Boolean",
          "constant": "false"
        }
      },
      {
        "kind": "SetVariable",
        "id": "initClipSWAccepted",
        "name": "初始化Clip.SWAccepted",
        "timeoutMs": 30000,
        "variableName": "Clip.SW.Accepted",
        "value": {
          "source": "Constant",
          "dataType": "Boolean",
          "constant": "false"
        }
      },
      {
        "kind": "SetVariable",
        "id": "initClipWPReady",
        "name": "初始化Clip.WPReady",
        "timeoutMs": 30000,
        "variableName": "Clip.WP.Ready",
        "value": {
          "source": "Constant",
          "dataType": "Boolean",
          "constant": "false"
        }
      },
      {
        "kind": "SetVariable",
        "id": "initClipWPAccepted",
        "name": "初始化Clip.WPAccepted",
        "timeoutMs": 30000,
        "variableName": "Clip.WP.Accepted",
        "value": {
          "source": "Constant",
          "dataType": "Boolean",
          "constant": "false"
        }
      },
      {
        "kind": "SetVariable",
        "id": "initClipPIReady",
        "name": "初始化Clip.PIReady",
        "timeoutMs": 30000,
        "variableName": "Clip.PI.Ready",
        "value": {
          "source": "Constant",
          "dataType": "Boolean",
          "constant": "false"
        }
      },
      {
        "kind": "SetVariable",
        "id": "initClipPIAccepted",
        "name": "初始化Clip.PIAccepted",
        "timeoutMs": 30000,
        "variableName": "Clip.PI.Accepted",
        "value": {
          "source": "Constant",
          "dataType": "Boolean",
          "constant": "false"
        }
      },
      {
        "kind": "SetVariable",
        "id": "initNext",
        "name": "初始化测试身份",
        "timeoutMs": 30000,
        "variableName": "Clip.NextA",
        "value": {
          "source": "Constant",
          "dataType": "Boolean",
          "constant": "true"
        }
      },
      {
        "kind": "SetVariable",
        "id": "initLastProduct",
        "name": "清空上次测试产品",
        "timeoutMs": 30000,
        "variableName": "Clip.LastProduct",
        "value": { "source": "Constant", "dataType": "String", "constant": "" }
      },
      {
        "kind": "SetVariable",
        "id": "initLastCarrier",
        "name": "清空上次测试载具",
        "timeoutMs": 30000,
        "variableName": "Clip.LastCarrier",
        "value": { "source": "Constant", "dataType": "String", "constant": "" }
      },
      {
        "kind": "SetVariable",
        "id": "initLastResult",
        "name": "清空上次测试结果",
        "timeoutMs": 30000,
        "variableName": "Clip.LastResult",
        "value": { "source": "Constant", "dataType": "String", "constant": "" }
      },
      {
        "kind": "SetVariable",
        "id": "initLastDestination",
        "name": "清空上次测试去向",
        "timeoutMs": 30000,
        "variableName": "Clip.LastDestination",
        "value": { "source": "Constant", "dataType": "String", "constant": "" }
      }
    ]
  }
}
