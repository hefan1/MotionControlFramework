{
  "schemaVersion": 1,
  "taskId": "ClipPressPrepare",
  "name": "压合工位回零",
  "revision": 2,
  "root": {
    "kind": "Sequence", "id": "PressPrepare", "name": "压合工位准备", "timeoutMs": 90000,
    "children": [
      { "kind": "WaitInput", "id": "PressNoMaterialBeforePrepare", "name": "确认上料位置无料", "timeoutMs": 3000, "inputName": "上料到位", "expected": false, "timeoutAlarmCodes": ["DEMO_SENSOR_TIMEOUT"] },
      { "kind": "SetOutput", "id": "PressOutputOff", "name": "确认压合动作输出关闭", "timeoutMs": 5000, "outputName": "压头动作", "value": false },
      { "kind": "WaitInput", "id": "PressFeedbackClear", "name": "等待压合完成反馈复位", "timeoutMs": 10000, "inputName": "压装完成", "expected": false, "timeoutAlarmCodes": ["DEMO_SENSOR_TIMEOUT"] },
      { "kind": "WaitInput", "id": "PressNoMaterialBeforeHome", "name": "回零前确认上料位置无料", "timeoutMs": 3000, "inputName": "上料到位", "expected": false, "timeoutAlarmCodes": ["DEMO_SENSOR_TIMEOUT"] },
      { "kind": "AxisCommand", "id": "PressHome", "name": "压合轴回零", "timeoutMs": 60000, "axisName": "Press_Z", "command": "Home" },
      { "kind": "WaitInput", "id": "PressNoMaterialBeforeStandby", "name": "返回待机位前确认上料位置无料", "timeoutMs": 3000, "inputName": "上料到位", "expected": false, "timeoutAlarmCodes": ["DEMO_SENSOR_TIMEOUT"] },
      { "kind": "MoveAxis", "id": "PressStandby", "name": "压合轴返回待机位置", "timeoutMs": 10000, "axisName": "Press_Z", "mode": "Absolute", "target": { "source": "Constant", "dataType": "Number", "constant": "0" }, "profile": { "speed": 5, "acceleration": 50, "deceleration": 50 } }
    ]
  }
}
